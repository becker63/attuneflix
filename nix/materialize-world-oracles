#!/usr/bin/env bash
set -euo pipefail

# Temporary Nix-to-Bazel migration boundary. Nix materializes the exact old
# source snapshot and emits only the facts required to authenticate and admit
# its retained observation envelope. Bazel owns every expensive operation
# after this small oracle record exists.
if (($# != 1)); then
  echo "usage: nix/materialize-world-oracles MANIFEST_INDEX|START-END|all|graph" >&2
  exit 2
fi

graph_only=false
if [[ "$1" == graph ]]; then
  graph_only=true
  indices=()
elif [[ "$1" == all ]]; then
  mapfile -t indices < <(seq 0 77)
elif [[ "$1" =~ ^([0-9]+)-([0-9]+)$ ]]; then
  start="${BASH_REMATCH[1]}"
  end="${BASH_REMATCH[2]}"
  if ((10#$start < 0 || 10#$end >= 78 || 10#$start > 10#$end)); then
    echo "manifest range must be within 0-77 and ordered" >&2
    exit 2
  fi
  mapfile -t indices < <(seq "$start" "$end")
else
  case "$1" in
    ''|*[!0-9]*)
      echo "manifest index must be an integer in [0, 77], START-END, or all" >&2
      exit 2
      ;;
  esac
  if ((10#$1 < 0 || 10#$1 >= 78)); then
    echo "manifest index must be in [0, 77]" >&2
    exit 2
  fi
  indices=("$1")
fi

workspace="$(pwd -P)"
oracle_root="$workspace/.attune/repository-world-migration-inputs"
mkdir -p "$oracle_root"

# Copy the frozen gold-free issue projection into an ordinary Bazel input.
# The old Nix store object is the migration oracle only; remote replay never
# receives its pathname and does not evaluate Nix.
localization_input_root="$workspace/.attune/localization-inputs"
mkdir -p "$localization_input_root"
mapfile -t issue_sources < <(
  find "$workspace/.attune/scale-input-roots" -maxdepth 1 \
    \( -type f -o -type l \) -name '*swe-explore-js-ts-issues-v1.json' -print
)
if ((${#issue_sources[@]} != 1)); then
  echo "expected exactly one frozen SWE-Explore JS/TS issue projection" >&2
  exit 1
fi
issues_tmp="$(mktemp "$localization_input_root/issues.json.XXXXXX")"
cp --dereference -- "${issue_sources[0]}" "$issues_tmp"
chmod u+rw,go+r "$issues_tmp"
mv -f -- "$issues_tmp" "$localization_input_root/issues.json"

for index in "${indices[@]}"; do
  output="$oracle_root/$index.json"
  temporary="$(mktemp "$oracle_root/$index.json.XXXXXX")"
  nix eval --impure --raw \
    --expr "import $workspace/nix/scale-case.nix { caseIndex = $index; }" |
    jq -ce '{
      version: 1,
      manifest_index: .manifest_index,
      instance_id: .instance_id,
      repository: .repository,
      base_revision: .base_revision,
      population: .population,
      source_tree_identity: .sourceTreeIdentity,
      legacy_snapshot: .snapshot,
      source_paths: [.sources[].path]
    } | select(
      (.manifest_index == '"$index"') and
      (.source_tree_identity | startswith("source-tree-js-ts-v1:")) and
      (.source_paths | length > 0)
    )' > "$temporary"
  mv "$temporary" "$output"
  printf 'WORLD_ORACLE index=%s paths=%s\n' \
    "$index" "$(jq -r '.source_paths | length' "$output")"
done

# Generated current graph. One-time migration can still authenticate old
# observations against Nix materializations above, but normal graph generation
# points at the already admitted typed worlds. No Nix path enters an action.
declare -A typed_world_by_revision
while IFS= read -r world_build; do
  revision="$(sed -n 's/^    base_revision = "\([^"]*\)",$/\1/p' "$world_build")"
  if [[ -z "$revision" ]]; then
    echo "typed world has no base revision: $world_build" >&2
    exit 1
  fi
  world_directory="$(basename "$(dirname "$world_build")")"
  if [[ -n "${typed_world_by_revision[$revision]:-}" ]]; then
    echo "duplicate typed world for revision $revision" >&2
    exit 1
  fi
  typed_world_by_revision[$revision]="$world_directory"
done < <(find "$workspace/.attune/repository-world-v1" -mindepth 2 -maxdepth 2 -name BUILD.bazel -type f -print | sort)

build_tmp="$(mktemp "$workspace/.attune/BUILD.bazel.XXXXXX")"
{
  printf 'load("//build:attune.bzl", "attune_atlas_aggregate", "attune_atlas_report", "attune_atlas_signature", "attune_atlas_signature_summaries", "attune_atlas_signature_summary", "attune_atlas_signatures", "attune_decision_bundle", "attune_decision_bundles", "attune_localization_evaluation", "attune_localization_evaluations", "attune_localization_replay", "attune_localization_replays")\n\n'
  targets=()
  signatures=()
  summaries=()
  replay_keys=()
  replay_worlds=()
  replay_instances=()
  replay_priors=()
  replay_revisions=()
  predictions=()
  evaluation_targets=()
  mapfile -t oracle_files < <(find "$oracle_root" -maxdepth 1 -type f -name '*.json' -print | sort -V)
  for oracle in "${oracle_files[@]}"; do
    index="$(basename "$oracle" .json)"
    revision="$(jq -r '.base_revision' "$oracle")"
    repository="$(jq -r '.repository' "$oracle")"
    instance="$(jq -r '.instance_id' "$oracle")"
    population="$(jq -r '.population' "$oracle")"
    source_tree="$(jq -r '.source_tree_identity' "$oracle")"
    world_directory="${typed_world_by_revision[$revision]:-}"
    if [[ -z "$world_directory" ]]; then
      echo "typed admitted world missing for manifest index $index revision $revision" >&2
      exit 1
    fi
    target="world_$(printf '%02d' "$index")"
    signature="signature_$(printf '%02d' "$index")"
    summary="summary_$(printf '%02d' "$index")"
    if [[ "$population" == historical-development ]]; then
      retained="repository-facts-v1/$revision.parquet"
    else
      retained="repository-facts-js-ts-scale-v1/$revision.parquet"
    fi
    if [[ ! -s "$workspace/.attune/$retained" ]]; then
      echo "retained fact artifact missing for manifest index $index" >&2
      exit 1
    fi
    targets+=(":$target")
    signatures+=(":$signature")
    summaries+=(":$summary")
    prior="semantic-prior-js-ts-scale-v1/rankings/$revision.parquet"
    prediction="experiments/swe-explore-js-ts-scale/013-predictions/$revision.parquet"
    if [[ "$population" == new && -s "$workspace/.attune/$prior" && -s "$workspace/.attune/$prediction" ]]; then
      replay_keys+=("$(printf '%02d' "$index")")
      replay_worlds+=("$target")
      replay_instances+=("$instance")
      replay_priors+=("$prior")
      replay_revisions+=("$revision")
      predictions+=("$prediction")
    fi
    printf 'alias(\n'
    printf '    name = "%s",\n' "$target"
    printf '    actual = "//.attune/repository-world-v1/%s:world",\n' "$world_directory"
    printf ')\n\n'
    printf 'attune_atlas_signature(\n'
    printf '    name = "%s",\n' "$signature"
    printf '    tool = "//experiments/atlas-swe-explore:signature",\n'
    printf '    world = ":%s",\n' "$target"
    printf ')\n\n'
    printf 'attune_atlas_signature_summary(\n'
    printf '    name = "%s",\n' "$summary"
    printf '    signature = ":%s",\n' "$signature"
    printf '    tool = "//experiments/atlas-swe-explore:summary",\n'
    printf ')\n\n'
  done
  printf 'filegroup(\n    name = "worlds",\n    srcs = [\n'
  for target in "${targets[@]}"; do
    printf '        "%s",\n' "$target"
  done
  printf '    ],\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_atlas_signatures(\n    name = "signatures",\n    signatures = [\n'
  for signature in "${signatures[@]}"; do
    printf '        "%s",\n' "$signature"
  done
  printf '    ],\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_atlas_signature_summaries(\n    name = "signature_summaries",\n    summaries = [\n'
  for summary in "${summaries[@]}"; do
    printf '        "%s",\n' "$summary"
  done
  printf '    ],\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_atlas_aggregate(\n    name = "atlas_data",\n    summaries = [\n'
  for summary in "${summaries[@]}"; do
    printf '        "%s",\n' "$summary"
  done
  printf '    ],\n    tool = "//experiments/atlas-swe-explore:aggregate",\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_atlas_report(\n    name = "atlas_report",\n    aggregate = ":atlas_data",\n    tool = "//experiments/atlas-swe-explore:report",\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nfilegroup(\n    name = "retained_scale_decision_envelopes",\n    srcs = glob([\n'
  printf '        "experiments/swe-explore-js-ts-scale/003-force-first-macro/raw/*.json",\n'
  printf '        "experiments/swe-explore-js-ts-scale/012-pruned-planner-portfolio/raw/*.json",\n'
  printf '        "experiments/swe-explore-js-ts-scale/013-deep-planner-portfolio/raw/*.json",\n'
  printf '    ]),\n)\n'
  printf '\nattune_decision_bundles(\n    name = "localization_decision_bundles",\n    case_keys = [\n'
  for key in "${replay_keys[@]}"; do
    printf '        "%s",\n' "$key"
  done
  printf '    ],\n    predictions = [\n'
  for prediction in "${predictions[@]}"; do
    printf '        "%s",\n' "$prediction"
  done
  printf '    ],\n    base_revisions = [\n'
  for revision in "${replay_revisions[@]}"; do
    printf '        "%s",\n' "$revision"
  done
  printf '    ],\n    raw_envelopes = [":retained_scale_decision_envelopes"],\n'
  printf '    tool = "//migration/localization:decision_bundle",\n)\n'
  for key in "${replay_keys[@]}"; do
    printf '\nattune_decision_bundle(\n'
    printf '    name = "localization_decisions_%s",\n' "$key"
    printf '    bundles = ":localization_decision_bundles",\n'
    printf '    case_key = "%s",\n' "$key"
    printf ')\n'
  done
  replay_targets=()
  for offset in "${!replay_keys[@]}"; do
    key="${replay_keys[$offset]}"
    replay_target="localization_replay_$key"
    replay_targets+=(":$replay_target")
    printf '\nattune_localization_replay(\n'
    printf '    name = "%s",\n' "$replay_target"
    printf '    decisions = ":localization_decisions_%s",\n' "$key"
    printf '    expected = "%s",\n' "${predictions[$offset]}"
    printf '    instance_id = "%s",\n' "${replay_instances[$offset]}"
    printf '    issues = "localization-inputs/issues.json",\n'
    printf '    prior = "%s",\n' "${replay_priors[$offset]}"
    printf '    tool = "//experiments/localization-swe-explore:replay",\n'
    printf '    world = ":%s",\n' "${replay_worlds[$offset]}"
    printf ')\n'
    geometry="evaluation-inputs/geometry/$key.parquet"
    if [[ -s "$workspace/.attune/$geometry" ]]; then
      evaluation_target="localization_evaluation_$key"
      evaluation_targets+=(":$evaluation_target")
      printf '\nattune_localization_evaluation(\n'
      printf '    name = "%s",\n' "$evaluation_target"
      printf '    frozen_results = "//experiments/swe-explore-js-ts-scale:results-censored.parquet",\n'
      printf '    geometry = "%s",\n' "$geometry"
      printf '    gold = "evaluation-inputs/gold.parquet",\n'
      printf '    instance_id = "%s",\n' "${replay_instances[$offset]}"
      printf '    issues = "localization-inputs/issues.json",\n'
      printf '    prior = "%s",\n' "${replay_priors[$offset]}"
      printf '    replay = ":%s",\n' "$replay_target"
      printf '    tool = "//experiments/localization-swe-explore:evaluate",\n'
      printf '    world = ":%s",\n' "${replay_worlds[$offset]}"
      printf ')\n'
    fi
  done
  printf '\nfilegroup(\n    name = "localization_replay_cases",\n    srcs = [\n'
  for replay_target in "${replay_targets[@]}"; do
    printf '        "%s",\n' "$replay_target"
  done
  printf '    ],\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_localization_replays(\n    name = "localization_replay",\n    replays = [\n'
  for replay_target in "${replay_targets[@]}"; do
    printf '        "%s",\n' "$replay_target"
  done
  printf '    ],\n    tool = "//experiments/localization-swe-explore:aggregate",\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nfilegroup(\n    name = "localization_evaluation_cases",\n    srcs = [\n'
  for evaluation_target in "${evaluation_targets[@]}"; do
    printf '        "%s",\n' "$evaluation_target"
  done
  printf '    ],\n    visibility = ["//visibility:public"],\n)\n'
  printf '\nattune_localization_evaluations(\n    name = "localization_evaluation",\n    evaluations = [\n'
  for evaluation_target in "${evaluation_targets[@]}"; do
    printf '        "%s",\n' "$evaluation_target"
  done
  printf '    ],\n    tool = "//experiments/localization-swe-explore:aggregate_evaluation",\n    visibility = ["//visibility:public"],\n)\n'
} > "$build_tmp"
mv "$build_tmp" "$workspace/.attune/BUILD.bazel"
