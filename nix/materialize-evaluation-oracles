#!/usr/bin/env bash
set -euo pipefail

# One-time Nix-to-Bazel evaluator migration. Nix supplies the exact frozen
# source tree and evaluator-only gold object. The Flix migration executable
# emits small typed tables with no source text or Nix pathname. Normal Bazel
# evaluation actions never invoke Nix.
if (($# != 1)); then
  echo "usage: nix/materialize-evaluation-oracles GOLD|INDEX|START-END|all" >&2
  exit 2
fi

workspace="$(pwd -P)"
input_root="$workspace/.attune/evaluation-inputs"
geometry_root="$input_root/geometry"
mkdir -p "$input_root" "$geometry_root"

bazel build //migration/evaluation:migrate \
  --config=buildbuddy-rbe \
  --remote_download_outputs=all >/dev/null
migrate="$workspace/bazel-bin/migration/evaluation/migrate"

materialize_gold() {
  local legacy temporary output
  legacy="$(nix eval --impure --raw \
    --expr "(import $workspace/nix/scale-evaluation.nix { raw = true; }).goldFixture")"
  output="$input_root/gold.parquet"
  temporary="$(mktemp "$input_root/gold.parquet.XXXXXX")"
  nice -n 10 ionice -c 3 "$migrate" \
    --jvm_flag=-Dattune.command=gold \
    --jvm_flag=-Dattune.legacy_gold="$legacy" \
    --jvm_flag=-Dattune.output_gold="$temporary"
  chmod u+rw,go+r "$temporary"
  mv -f -- "$temporary" "$output"
}

if [[ "$1" == GOLD ]]; then
  materialize_gold
  exit 0
elif [[ "$1" == all ]]; then
  mapfile -t indices < <(seq 0 77)
elif [[ "$1" =~ ^([0-9]+)-([0-9]+)$ ]]; then
  start="${BASH_REMATCH[1]}"
  end="${BASH_REMATCH[2]}"
  if ((10#$start < 0 || 10#$end >= 78 || 10#$start > 10#$end)); then
    echo "manifest range must be within 0-77 and ordered" >&2
    exit 2
  fi
  mapfile -t indices < <(seq "$start" "$end")
else
  case "$1" in
    ''|*[!0-9]*)
      echo "manifest index must be in [0, 77], START-END, all, or GOLD" >&2
      exit 2
      ;;
  esac
  if ((10#$1 < 0 || 10#$1 >= 78)); then
    echo "manifest index must be in [0, 77]" >&2
    exit 2
  fi
  indices=("$1")
fi

targets=()
for index in "${indices[@]}"; do
  targets+=("//.attune:world_$(printf '%02d' "$index")")
done
bazel build "${targets[@]}" \
  --config=buildbuddy-rbe \
  --remote_download_outputs=all >/dev/null

for index in "${indices[@]}"; do
  key="$(printf '%02d' "$index")"
  world="$workspace/bazel-bin/.attune/world_$key"
  oracle="$workspace/.attune/repository-world-migration-inputs/$index.json"
  output="$geometry_root/$key.parquet"
  temporary="$(mktemp "$geometry_root/$key.parquet.XXXXXX")"
  nice -n 10 ionice -c 3 "$migrate" \
    --jvm_flag=-Dattune.command=geometry \
    --jvm_flag=-Dattune.oracle="$oracle" \
    --jvm_flag=-Dattune.world_identity="$world/identity.json" \
    --jvm_flag=-Dattune.world_metadata="$world/metadata.parquet" \
    --jvm_flag=-Dattune.world_entities="$world/entities.parquet" \
    --jvm_flag=-Dattune.world_relations="$world/relations.parquet" \
    --jvm_flag=-Dattune.output_geometry="$temporary"
  chmod u+rw,go+r "$temporary"
  mv -f -- "$temporary" "$output"
done
