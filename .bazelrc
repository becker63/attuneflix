build --enable_bzlmod
build --announce_rc
build --local_resources=cpu=4
build --local_resources=memory=4096
build --jobs=4
build --java_language_version=25
build --tool_java_language_version=25
build --java_runtime_version=remotejdk_25
build --tool_java_runtime_version=remotejdk_25
# crate_universe writes these path-dependency projections beside the workspace
# even though build/grit_repository.bzl supplies their real pinned sources in
# @gritql_source. They are not main-repository packages.
build --deleted_packages=resources/language-metavariables/tree-sitter-javascript,resources/language-metavariables/tree-sitter-typescript,vendor/tree-sitter-facade,vendor/tree-sitter-gritql,vendor/web-tree-sitter
test --test_output=errors
# `bazel test //...` is the ordinary law suite. Bazel otherwise also builds
# every non-test target matched by `//...`, including the explicit Atlas
# census graph. Heavy deterministic science remains available through its
# named `bazel build` targets.
test --build_tests_only

# aspect_tools_telemetry (pulled in by rules_js/rules_ts) reports usage unless
# disabled; an empty value does NOT disable it, "-all" does.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# Authentication is supplied by the local credential helper from ignored .env.
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache_compression
build:buildbuddy --remote_grpc_log=bazel-remote-grpc.log
build:buildbuddy --execution_log_compact_file=execution_log.binpb.zst
build:buildbuddy --noslim_profile
build:buildbuddy --experimental_profile_include_target_label
build:buildbuddy --experimental_profile_include_primary_output
build:buildbuddy-rbe --config=buildbuddy
build:buildbuddy-rbe --remote_executor=grpcs://remote.buildbuddy.io
build:buildbuddy-rbe --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:buildbuddy-rbe --jobs=80
test:buildbuddy-rbe --test_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# From an aarch64 host the target platform is aarch64: its test runfiles and the
# host-arch jextract archive only execute on BuildBuddy's arm64 runners. The flag
# overrides (does not extend) the x86_64 platform above.
build:buildbuddy-rbe-arm64 --config=buildbuddy-rbe
build:buildbuddy-rbe-arm64 --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_arm64
# `local = True` law tests (control_reproducibility_test) run on this NixOS host,
# whose coreutils and git live only under /run/current-system/sw/bin; the extra
# entry is inert on the Ubuntu executors.
test:buildbuddy-rbe-arm64 --test_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin

# Full-census physical measurement is remote only. BuildBuddy held all 160
# requested actions on 2026-09-29; local JVM execution is forbidden by the
# physical rules' no-local requirement. The 256-job follow-up preserves the
# completed action keys while reducing the batch tail.
build:atlas-live-physical-population --config=buildbuddy-rbe-arm64
build:atlas-live-physical-population --spawn_strategy=remote
build:atlas-live-physical-population --jobs=256
build:atlas-live-physical-population --remote_download_minimal

# Archives preserve recorded Families raw inputs in BuildBuddy. The archive
# build transfers many small source files; allow a longer CAS call timeout and
# bound concurrency independently of the physical population build.
build:atlas-families-evidence-archive --config=buildbuddy-rbe-arm64
build:atlas-families-evidence-archive --spawn_strategy=remote
build:atlas-families-evidence-archive --remote_timeout=30m
build:atlas-families-evidence-archive --remote_download_toplevel
# Each raw evidence archive has thousands of input files. Concurrent uploads
# hit BuildBuddy bulk-transfer pipe failures on large worlds; serialize this
# preservation stage while acquisition and physical computation retain their
# separate parallelism settings.
build:atlas-families-evidence-archive --jobs=1

# Atlas Live's browser/TypeScript actions stay on this host. Flix compilation,
# family derivation, and physical measurements run on arm64 BuildBuddy.
# One local action at a time protects the 15 GiB / no-swap graphical session.
build:atlas-live-mixed --config=buildbuddy-rbe-arm64
build:atlas-live-mixed --spawn_strategy=sandboxed
build:atlas-live-mixed --strategy=FlixFatJar=remote
build:atlas-live-mixed --strategy=FlixCheck=remote
build:atlas-live-mixed --strategy=FamiliesInventory=remote
build:atlas-live-mixed --strategy=FamiliesInventoryReport=remote
build:atlas-live-mixed --strategy=FamiliesProtocol=remote
build:atlas-live-mixed --strategy=FamiliesReplay=remote
build:atlas-live-mixed --strategy=FamiliesAcquisitionReport=remote
build:atlas-live-mixed --strategy=FamiliesCluster=remote
build:atlas-live-mixed --strategy=FamiliesClusteringReport=remote
build:atlas-live-mixed --strategy=FamiliesMethod=remote
build:atlas-live-mixed --strategy=FamiliesEdges=remote
build:atlas-live-mixed --strategy=FamiliesExport=remote
build:atlas-live-mixed --strategy=FamiliesExportReport=remote
build:atlas-live-mixed --strategy=AtlasLivePhysicalShard=remote
build:atlas-live-mixed --strategy=AtlasLivePhysicalMerge=remote
build:atlas-live-mixed --strategy=AtlasSignature=remote
build:atlas-live-mixed --strategy=AtlasSignatureSummary=remote
build:atlas-live-mixed --strategy=AtlasAggregate=remote
build:atlas-live-mixed --strategy=AtlasReport=remote
build:atlas-live-mixed --strategy=Vite=local
build:atlas-live-mixed --jobs=1
build:atlas-live-mixed --action_env=NODE_OPTIONS=--max-old-space-size=2048
build:atlas-live-mixed --noremote_upload_local_results
test:atlas-live-mixed --test_env=NODE_OPTIONS=--max-old-space-size=2048
