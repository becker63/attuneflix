load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//experiments/atlas-families:acquired_worlds.bzl", "ACQUIRED_DIGESTS")
load("//experiments/atlas-families:families.bzl", "ACQUIRED_WORLDS", "FAMILY_EXPORTS")
load("//experiments/atlas-live-physical:physical.bzl", "PHYSICAL_EXPORTS")
load("//experiments/atlas-live-self:self.bzl", "SELF_DIGEST", "SELF_WORLD")
load("//experiments/atlas-location-export:locations.bzl", "location_exports")
load("//experiments/atlas-swe-explore/census:census.bzl", "ATLAS_WORLDS")
load("//web/atlas-live:defs.bzl", "LAUNCHER_ENV", "atlas_ts_package")

# React-free: runs under Node in Bazel and in the browser (enforced by .oxlintrc.json).
atlas_ts_package(
    declarations = True,
    npm_deps = [
        "@types/node",
        "apache-arrow",
        "hyparquet",
        "vitest",
    ],
    test_data = [
        ":axios_world",
        ":layout_worlds",
        ":physical_preact",
    ],
    test_env = {"WORLD_ROOT": "axios_world"},
)

# The smallest real world (axios/axios), for the round-trip unit tests.
copy_to_directory(
    name = "axios_world",
    srcs = ["//.attune/repository-world-v1/1e44a1c45ec4a91bb7774dc6d37a2846a5f56262b6fa7ae5722bcbcc15ba10c7:world"],
    root_paths = [".attune/repository-world-v1"],
)

# The 78 frozen census worlds plus one separately pinned AttuneFlix snapshot.
copy_to_directory(
    name = "worlds",
    srcs = ATLAS_WORLDS + [SELF_WORLD],
    root_paths = [
        ".attune/repository-world-v1",
        ".attune/atlas-live-self-v1",
    ],
    visibility = ["//visibility:public"],
)

# One Flix-derived locations.parquet per frozen world, staged as
# <digest>/locations.parquet. The declaration order is ATLAS_WORLDS order; the
# exporter is the single owner of directory-prefix derivation.
_LOCATION_EXPORTS = location_exports(tool = "//experiments/atlas-location-export:locations_tool")

copy_to_directory(
    name = "locations",
    srcs = _LOCATION_EXPORTS + ["//experiments/atlas-live-self:locations"],
    root_paths = [
        "web/atlas-live/projection",
        "experiments/atlas-live-self",
    ],
    visibility = ["//visibility:public"],
)

# The Flix-derived families export of every world that has families (Atlas
# Families; preact first), staged as <digest>/{families,family_*}.parquet. The
# exporter is the single owner of the tables; `//experiments/atlas-families:
# families_export_parity_test` holds this staging to the Flix-built tables.
copy_to_directory(
    name = "families",
    srcs = FAMILY_EXPORTS,
    root_paths = ["experiments/atlas-families"],
    visibility = ["//visibility:public"],
)

# One Bazel-derived depth-7 physical-work table per frozen census snapshot.
# The frozen 16-seed census table remains untouched as a parity oracle.
copy_to_directory(
    name = "physical",
    srcs = PHYSICAL_EXPORTS + ["//experiments/atlas-live-self:physical"],
    root_paths = [
        "experiments/atlas-live-physical",
        "experiments/atlas-live-self",
    ],
    visibility = ["//visibility:public"],
)

# A narrow Preact-only fixture for parity and projection unit laws. The web
# release data target below consumes the full 78-world physical population.
copy_to_directory(
    name = "physical_preact",
    srcs = ["//experiments/atlas-live-physical:preact_physical"],
    root_paths = ["experiments/atlas-live-physical"],
)

copy_to_directory(
    name = "physical_frozen",
    srcs = ["//experiments/atlas-swe-explore:physical.parquet"],
    root_paths = ["experiments/atlas-swe-explore"],
)

# The frozen 16-seed repository signature medians (typed Flix report table).
# The web projection copies measured values into the manifest; it does not
# infer architecture from the current rendering or the all-seed color field.
copy_to_directory(
    name = "signatures",
    srcs = ["//experiments/atlas-swe-explore/census:report"],
    root_paths = ["experiments/atlas-swe-explore/census"],
)

copy_to_directory(
    name = "self_signatures",
    srcs = ["//experiments/atlas-live-self:signature_report"],
    root_paths = ["experiments/atlas-live-self"],
)

# The real worlds the app's structural-layout and frontier unit tests read
# (preactjs/preact, the default world; babel/babel, the largest snapshot; and
# axios/axios, the smallest compartmental world the wire conservation laws
# name), each staged with its locations table as
# <digest>/{metadata,entities,relations,locations}.parquet.
# Only the fixture worlds with a families export carry their five family_*.parquet
# files. The release :families target above still stages every acquired world.
_LAYOUT_WORLDS = [
    "//.attune/repository-world-v1/6e2bef41bf19f638be084df8cb82127e4832d4abbafa8ca20ebd5db9be3ac8a9:world",
    "//.attune/repository-world-v1/002a462e6f58440bbf60071f1e945b38bb304fe46a38ca6fdfd578248693cf01:world",
    "//.attune/repository-world-v1/1e44a1c45ec4a91bb7774dc6d37a2846a5f56262b6fa7ae5722bcbcc15ba10c7:world",
]

_FAMILY_EXPORT_BY_WORLD = {
    pair[1]: FAMILY_EXPORTS[index]
    for index, pair in enumerate(ACQUIRED_WORLDS)
}

copy_to_directory(
    name = "layout_worlds",
    srcs = _LAYOUT_WORLDS + [_FAMILY_EXPORT_BY_WORLD[world] for world in _LAYOUT_WORLDS if world in _FAMILY_EXPORT_BY_WORLD] + [_LOCATION_EXPORTS[ATLAS_WORLDS.index(world)] for world in _LAYOUT_WORLDS],
    root_paths = [
        ".attune/repository-world-v1",
        "experiments/atlas-families",
        package_name(),
    ],
    visibility = ["//web/atlas-live:__subpackages__"],
)

# Expected snapshot digests: the frozen census plus the separately pinned self world.
genrule(
    name = "expected_worlds",
    outs = ["expected_worlds.txt"],
    cmd = "printf '%s\\n' " + " ".join(sorted([
        label.split("/")[-1].split(":")[0]
        for label in ATLAS_WORLDS + [SELF_WORLD]
    ])) + " > $@",
    visibility = ["//visibility:public"],
)

# User stopped acquisition after the sealed cohort. Keep the validation
# population tied to the Starlark declarations, never a hard-coded count.
genrule(
    name = "expected_families",
    outs = ["expected_families.txt"],
    cmd = "printf '%s\\n' " + " ".join(sorted(ACQUIRED_DIGESTS)) + " > $@",
)

# Node CLI: projects and validates every staged world, copies the Parquet inputs
# into data/<digest>/, and writes manifest.json. Node 24 strips the TypeScript
# types natively, so the same sources run here, in Vitest, and in the browser.
js_binary(
    name = "project_cli",
    data = [":srcs"],
    entry_point = "src/cli.ts",
)

# The synthetic 10k-node / 50k-edge stress fixture, generated deterministically in
# the projection input format (metadata/entities/relations/locations Parquet).
js_binary(
    name = "synthetic_cli",
    data = [":srcs"],
    entry_point = "src/synthetic_cli.ts",
)

js_run_binary(
    name = "synthetic_world",
    args = [
        "--out",
        "synthetic",
    ],
    chdir = package_name(),
    env = LAUNCHER_ENV,
    out_dirs = ["synthetic"],
    tool = ":synthetic_cli",
    visibility = ["//visibility:public"],
)

# Seven small local-import fixture folders under `import_fixtures/` (see
# projection/src/import_fixtures.ts), in the canonical world Parquet format so
# the browser imports them through the identical projection path. Validators copy
# a folder to /tmp and upload it; `import_fixtures_test` pins each outcome.
js_binary(
    name = "import_fixtures_cli",
    data = [":srcs"],
    entry_point = "src/import_fixtures.ts",
)

js_run_binary(
    name = "import_fixtures",
    args = [
        "--out",
        "import_fixtures",
    ],
    chdir = package_name(),
    env = LAUNCHER_ENV,
    out_dirs = ["import_fixtures"],
    tool = ":import_fixtures_cli",
    visibility = ["//visibility:public"],
)

js_test(
    name = "import_fixtures_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":import_fixtures",
        ":srcs",
    ],
    entry_point = "test/import_fixtures_check.ts",
)

js_run_binary(
    name = "data",
    srcs = [
        ":families",
        ":locations",
        ":physical",
        ":self_signatures",
        ":signatures",
        ":synthetic_world",
        ":worlds",
    ],
    args = [
        "--worlds",
        "worlds",
        "--out",
        "data",
        "--locations",
        "locations",
        "--families",
        "families",
        "--physical",
        "physical",
        "--signatures",
        "signatures/report/repositories.parquet",
        "--self-signatures",
        "self_signatures/signature_report/repositories.parquet",
        "--synthetic",
        "synthetic",
    ],
    chdir = package_name(),
    env = LAUNCHER_ENV,
    out_dirs = ["data"],
    tool = ":project_cli",
    visibility = ["//visibility:public"],
)

# Validates manifest.json against ATLAS_WORLDS, the metadata Parquet of every
# shipped world, and the sha256 of every shipped file (VAL-PROJ-010).
js_test(
    name = "data_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":data",
        ":expected_families",
        ":expected_worlds",
        ":self_signatures",
        ":signatures",
        ":srcs",
    ],
    entry_point = "test/data_check.ts",
)

# The new all-seed view measurement is an exact extension of the frozen Preact
# 16-seed panel. This law also checks complete file/symbol coverage.
js_test(
    name = "physical_parity_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":layout_worlds",
        ":physical_frozen",
        ":physical_preact",
        ":srcs",
    ],
    entry_point = "test/physical_check.ts",
)

# The checked-in sources (no npm deps); scanned by //web/atlas-live:secret_scan_test.
js_library(
    name = "scan_files",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//web/atlas-live:__pkg__"],
)
