load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//web/atlas-live:vite/package_json.bzl", vite_bin = "bin")
load("@npm//web/atlas-live:vitest/package_json.bzl", vitest_bin = "bin")
load("//web/atlas-live:defs.bzl", "LAUNCHER_ENV", "atlas_ts_package")

# Runtime + typecheck npm deps of the app.
NPM_DEPS = [
    "@base-ui/react",
    "@cosmograph/react",
    "@duckdb/duckdb-wasm",
    "@stylexjs/stylex",
    "@types/react",
    "@types/react-dom",
    "apache-arrow",
    "hyparquet",
    "jotai",
    "react",
    "react-dom",
    "vite",
    "vitest",
]

# Extra packages only the Vite build needs (transpile, React Compiler, StyleX).
VITE_DEPS = [
    "@babel/core",
    "@rolldown/plugin-babel",
    "@stylexjs/unplugin",
    "@vitejs/plugin-react",
    "babel-plugin-react-compiler",
    "unplugin",
]

atlas_ts_package(
    npm_deps = NPM_DEPS,
    packages = [
        "projection",
        "protocol",
    ],
    # Real and fixture worlds for the structural-layout properties
    # (test/structure.test.ts reads them relative to this package).
    test_data = [
        "//web/atlas-live/projection:import_fixtures",
        "//web/atlas-live/projection:layout_worlds",
    ],
)

# Pure topology and measurement modules shared by the browser and public MCP.
js_library(
    name = "frontier_srcs",
    srcs = glob(["src/frontier/*.ts"]) + [
        "src/geometry.ts",
        "src/physicalRegion.ts",
        "src/structure.ts",
    ],
    deps = ["//web/atlas-live/projection:srcs"],
    visibility = ["//web/atlas-live:__subpackages__"],
)

# Pure frontier/inspector checks have no Parquet world data dependency. Keep
# this fast loop separate from :unit_test, which intentionally stages every
# acquired Families world for its real-data laws.
vitest_bin.vitest_test(
    name = "inspector_unit_test",
    size = "small",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
        "test/inspector.test.ts",
    ],
    chdir = package_name(),
    data = [
        "vitest.config.mjs",
        ":srcs",
        ":test_srcs",
        "//web/atlas-live:node_modules/vitest",
        "//web/atlas-live/projection:srcs",
    ],
    env = LAUNCHER_ENV,
)

vitest_bin.vitest_test(
    name = "proofs_unit_test",
    size = "small",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
        "test/proofs.test.ts",
    ],
    chdir = package_name(),
    data = [
        "vitest.config.mjs",
        ":srcs",
        ":test_srcs",
        "//web/atlas-live:node_modules/vitest",
        "//web/atlas-live/projection:srcs",
    ],
    env = LAUNCHER_ENV,
)

vitest_bin.vitest_test(
    name = "viewer_unit_test",
    size = "small",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
        "test/atoms.test.ts",
        "test/vocabulary.test.ts",
    ],
    chdir = package_name(),
    data = [
        "vitest.config.mjs",
        ":srcs",
        ":test_srcs",
        "//web/atlas-live:node_modules/vitest",
        "//web/atlas-live/projection:srcs",
    ],
    env = LAUNCHER_ENV,
)

# Everything the bundler reads: the app sources and entry, plus the projection
# and protocol sources it imports through relative paths.
js_library(
    name = "app_srcs",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
        "public/**/*",
    ]) + [
        "index.html",
        "vite.config.mjs",
    ],
    deps = ["//web/atlas-live:node_modules/%s" % dep for dep in NPM_DEPS + VITE_DEPS] + [
        "//web/atlas-live/projection:srcs",
        "//web/atlas-live/protocol:srcs",
    ],
)

vite_bin.vite(
    name = "dist",
    srcs = [":app_srcs"],
    args = [
        "build",
        "--configLoader",
        "native",
    ],
    chdir = package_name(),
    env = LAUNCHER_ENV,
    out_dirs = ["dist"],
    # Rolldown resolves index.html through the local sandbox's symlinks to the
    # real execroot, then rejects the resulting out-of-root asset name. Remote
    # executors materialize real files, so this only changes local spawns.
    tags = ["no-sandbox"],
    visibility = ["//web/atlas-live:__subpackages__"],
)

# The checked-in files the bundle is built from, without their npm deps, so
# //web/atlas-live:secret_scan_test can scan them next to :vercel_output: a
# planted credential fails the scan even where the bundler would drop the file.
js_library(
    name = "scan_files",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
    ]) + [
        "index.html",
        "vite.config.mjs",
    ],
    visibility = ["//web/atlas-live:__pkg__"],
)
