package(default_visibility = ["//visibility:public"])

# Milestone 1 — control record and preregistration.
#
# `PREREGISTRATION.md` is the frozen specification: the effectful typed-stage
# hypothesis, the formal Candidate A/B/C/D hypotheses and concurrency targets,
# the metric formulas (k-way cut, cross-stage invalidation, shared hotspots,
# kernel size tax, T_inf/T_1 critical path) and the stopping rules.
# `baseline-metrics.json` is the machine-readable control measurement
# (VAL-CTRL-002); `CONTROL.md`/`control-baseline.json` pin the frozen control
# specimen (VAL-CTRL-001).
#
# `measure_baseline` is the bootstrap instrument of record. `bazel run` it from
# the workspace root; it writes `baseline-metrics.json` back into this package.
# The script is temporary `bazel run` plumbing (the BUILD channel is inherently
# a `bazel query`); the graph math is scheduled to move to a deterministic Flix
# analysis target with Starlark wiring (PREREGISTRATION.md §13).
filegroup(
    name = "control_documents",
    srcs = [
        "CONTROL.md",
        "PREREGISTRATION.md",
        "baseline-metrics.json",
        "control-baseline.json",
    ],
)

# Milestone 2/3/4 — Candidate A/B/C/D measurements (PREREGISTRATION.md §7, §8,
# §10, §16).
#
# Each record is the identical instrument's reading of a candidate *revision*
# (measured from a worktree detached at that revision, so the record's
# `working_commit` names exactly the measured tree). Every record carries the
# frozen metric of record *and* the §16 supplementary `*_dagref` reading, so
# the `_dagref` rows in `candidates/README.md` are backed by machine-readable
# fields for every generation, not only Candidate D. `candidates/README.md`
# states the provenance recipe, the revision set and the measured deltas
# against `baseline-metrics.json`, including the negative ones (§7 non-rule).
filegroup(
    name = "candidate_measurements",
    srcs = [
        "candidates/README.md",
        "candidates/candidate-a.json",
        "candidates/candidate-b.json",
        "candidates/candidate-c.json",
        "candidates/candidate-d.json",
    ],
)

sh_binary(
    name = "measure_baseline",
    srcs = ["scripts/measure_baseline_metrics.sh"],
)

# `measure_candidates` drives the same instrument over the frozen candidate
# *revisions*, each in a detached worktree at that revision, and writes one
# record per generation into `candidates/` (VAL-METRIC-001). It takes no metric
# or partition of its own; later generations are added with
# `ATTUNE_CANDIDATES=<name>=<rev>...`.
sh_binary(
    name = "measure_candidates",
    srcs = ["scripts/measure_candidates.sh"],
)
