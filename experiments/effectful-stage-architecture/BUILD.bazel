package(default_visibility = ["//visibility:public"])

# Milestone 1 — control record and preregistration.
#
# `PREREGISTRATION.md` is the frozen specification: the effectful typed-stage
# hypothesis, the formal Candidate A/B/C/D hypotheses and concurrency targets,
# the metric formulas (k-way cut, cross-stage invalidation, shared hotspots,
# kernel size tax, T_inf/T_1 critical path) and the stopping rules.
# `baseline-metrics.json` is the machine-readable control measurement
# (VAL-CTRL-002); `CONTROL.md`/`control-baseline.json` pin the frozen control
# specimen (VAL-CTRL-001).
#
# `measure_baseline` is the bootstrap instrument of record. `bazel run` it from
# the workspace root; it writes `baseline-metrics.json` back into this package.
# The script is temporary `bazel run` plumbing (the BUILD channel is inherently
# a `bazel query`); the graph math is scheduled to move to a deterministic Flix
# analysis target with Starlark wiring (PREREGISTRATION.md §13).
filegroup(
    name = "control_documents",
    srcs = [
        "CONTROL.md",
        "PREREGISTRATION.md",
        "baseline-metrics.json",
        "control-baseline.json",
    ],
)

# Milestone 2/3/4 — Candidate A/B/C/D measurements (PREREGISTRATION.md §7, §8,
# §10, §16).
#
# Each record is the identical instrument's reading of a candidate *revision*
# (measured from a worktree detached at that revision, so the record's
# `working_commit` names exactly the measured tree). Every record carries the
# frozen metric of record *and* the §16 supplementary `*_dagref` reading, so
# the `_dagref` rows in `candidates/README.md` are backed by machine-readable
# fields for every generation, not only Candidate D. `candidates/README.md`
# states the provenance recipe, the revision set and the measured deltas
# against `baseline-metrics.json`, including the negative ones (§7 non-rule).
filegroup(
    name = "candidate_measurements",
    srcs = [
        "candidates/README.md",
        "candidates/candidate-a.json",
        "candidates/candidate-b.json",
        "candidates/candidate-c.json",
        "candidates/candidate-d.json",
    ],
)

# Milestone 5 — reproducibility evidence for the preserved Candidate D record.
#
# `reproduction-head.json` is a fresh run of the instrument of record at HEAD
# (`d8d9b037`) written to a new path; `reproduction-head-diff.json` is its
# machine-readable diff against `candidates/candidate-d.json`. The whole-record
# diff contains exactly three differing leaf paths — `recorded_at_utc`,
# `working_commit`, `channels.build.analyzed_targets` — and the records are
# byte-identical after deleting those (VAL-PROV-002). No committed record is
# overwritten by this evidence.
filegroup(
    name = "reproduction_evidence",
    srcs = [
        "candidates/reproduction-head.json",
        "candidates/reproduction-head-diff.json",
    ],
)

sh_binary(
    name = "measure_baseline",
    srcs = ["scripts/measure_baseline_metrics.sh"],
)

# `measure_candidates` drives the same instrument over the frozen candidate
# *revisions*, each in a detached worktree at that revision, and writes one
# record per generation into `candidates/` (VAL-METRIC-001). It takes no metric
# or partition of its own; later generations are added with
# `ATTUNE_CANDIDATES=<name>=<rev>...`.
sh_binary(
    name = "measure_candidates",
    srcs = ["scripts/measure_candidates.sh"],
)

# Milestone 5 — invalidation provenance & fan-out (VAL-PROV-003 / VAL-PROV-004).
#
# `provenance_analysis` is the ranked attribution of the 59 -> 253 (and
# 59 -> 173 `_dagref`) cross_stage_test_invalidation increase to concrete
# source files, with the per-node fan-out distribution, the top-1/3/5/10
# cumulative shares and the explicit broad-vs-hub verdict. The machine-readable
# record carries a `method.commands` section naming every command behind every
# number; the markdown renders the same tables.
#
# `extract_invalidation_provenance` is the deterministic per-file extractor
# behind both artifacts. It reproduces the instrument-of-record BUILD channel
# exactly (fidelity gate: 253/664/173 at Candidate D, 59/260/59 at control),
# and its `analyze`, `crosscheck` and `basis` modes join/rank, re-derive the
# quantity from the reverse `deps` direction, and emit the BASIS static graph.
# It never re-runs or modifies the instrument of record.
#
# `merge_provenance_artifact.jq` joins the extract/analyze/crosscheck/basis
# outputs into `candidates/provenance-analysis.json`; `render_provenance_analysis`
# renders the markdown tables from that JSON, so no number is typed by hand.
filegroup(
    name = "provenance_analysis",
    srcs = [
        "PROVENANCE_AND_CAUSAL_ANALYSIS.md",
        "candidates/provenance-analysis.json",
    ],
)

sh_binary(
    name = "extract_invalidation_provenance",
    srcs = ["scripts/extract_invalidation_provenance.sh"],
)

sh_binary(
    name = "render_provenance_analysis",
    srcs = ["scripts/render_provenance_analysis.sh"],
)
