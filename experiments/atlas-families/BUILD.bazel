load("//test/build:flix.bzl", "checked_test", "flix_check", "flix_fatjar")
load(":evidence_archive.bzl", "families_evidence_archives")
load(
    ":families.bzl",
    "families_acquisitions",
    "families_clusterings",
    "families_exports",
    "families_inventories",
    "families_issue_blindness_tests",
    "families_launchers",
    "families_method",
    "families_protocol",
)

package(default_visibility = ["//visibility:public"])

exports_files([
    "acquisition_population.json",
    "acquire_population.py",
    "acquired_worlds.bzl",
    "evidence_cas.py",
    "seal_evidence.py",
])

# The experiment's own production sources, in one declaration so the tool and
# the law check compile the same closure. `src/` mirrors the repository `src/`
# layout (Flix binds a module name to its file path), so promoting a module is
# a move, not a rewrite.
filegroup(
    name = "families_sources",
    srcs = [
        "src/Families.flix",
        "src/Families/Affinity.flix",
        "src/Families/Cluster.flix",
        "src/Families/Cluster/Law.flix",
        "src/Families/Cluster/Table.flix",
        "src/Families/Decision.flix",
        "src/Families/Decision/Table.flix",
        "src/Families/Edge.flix",
        "src/Families/Edge/Law.flix",
        "src/Families/Edge/Table.flix",
        "src/Families/Embedding.flix",
        "src/Families/Embedding/Table.flix",
        "src/Families/Evidence.flix",
        "src/Families/Export.flix",
        "src/Families/Inventory.flix",
        "src/Families/Inventory/Table.flix",
        "src/Families/Ledger.flix",
        "src/Families/Method.flix",
        "src/Families/Navigation.flix",
        "src/Families/Pass.flix",
        "src/Families/Protocol.flix",
        "src/Families/Provider.flix",
        "src/Families/Recorded.flix",
        "src/Families/Replay.flix",
        "src/Families/Report.flix",
        "src/Families/Rollup.flix",
        "src/Families/Rows.flix",
        "src/Families/Wire.flix",
    ],
)

# Everything the families sources compile against: Repository admission and
# the typed world tables, Atlas and its physical evaluator, and the typed-table
# and identity seams. No Localization module, population, or gold is in it.
filegroup(
    name = "families_closure",
    srcs = [
        ":families_sources",
        "//src:Atlas.flix",
        "//src:Radii.flix",
        "//src:Repository.flix",
        "//src:Repository/Grit.flix",
        "//src:Repository/Location.flix",
        "//src:Repository/Physical.flix",
        "//src:Repository/Structure.flix",
        "//src:Repository/Table.flix",
        "//src:ScientificIdentity.flix",
        "//src:ScientificTable.flix",
        "//src:ScientificTable/Columns.flix",
    ],
)

# The families experiment tool (Atlas Families; charter in REPORT.md). It
# declares no atom, depth, or repository rule of its own, and it reaches a
# provider only through the in-tree inference seam, only from `acquire`.
flix_fatjar(
    name = "families_flix",
    srcs = [
        "ClusteringLaw.flix",
        "EdgeLaw.flix",
        "Main.flix",
        ":families_closure",
        "//src:Experiment.flix",
    ],
    java_deps = [
        "//src/native/identity:attune_identity",
        "//src/native/inference:attune_inference",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

java_binary(
    name = "families_tool",
    jvm_flags = [
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--enable-native-access=ALL-UNNAMED",
        "-Xss8m",
    ],
    main_class = "Main",
    visibility = ["//visibility:public"],
    runtime_deps = [":families_flix"],
)

# Pack recorded raw envelopes and typed tables into one immutable BuildBuddy
# artifact per sealed snapshot. The output is derivable from declared local
# evidence; hydration from the remote CAS is an explicit operator step.
java_binary(
    name = "evidence_archive_tool",
    srcs = ["native/EvidenceArchive.java"],
    main_class = "attune.families.EvidenceArchive",
)

java_binary(
    name = "clustering_report_merge_tool",
    srcs = ["native/ClusteringReportMerge.java"],
    main_class = "attune.families.ClusteringReportMerge",
)

families_evidence_archives(tool = ":evidence_archive_tool")

# One typed inventory per representative frozen world, and the Markdown
# projection `report_test` pins REPORT.md against.
families_inventories(
    name = "inventory_report",
    tool = ":families_tool",
)

# The issue-blind acquisition protocol: its pinned constants and exact
# instructions (PROTOCOL.md), one live launcher per acquired world
# (`acquire_<key>`, run outside Bazel with the key), one keyless replay proof
# per acquired world (`replay_<key>`), and the acquisition report over them.
families_protocol(
    name = "protocol_constants",
    tool = ":families_tool",
)

families_launchers(tool = ":families_tool")

ACQUIRED_EVIDENCE = families_acquisitions(
    name = "acquisition_report",
    tool = ":families_tool",
)

# The clustering method (`atlas-families-v1`): its versioned constants
# (PROTOCOL.md), the method's tables per acquired world built twice as
# independent content-addressed actions (`cluster_<key>`, `cluster_<key>_rerun`)
# over the recorded evidence only, the clustering report, and the table and
# families laws over both runs.
families_method(
    name = "method_constants",
    tool = ":families_tool",
)

CLUSTERING_LAWS = families_clusterings(
    name = "clustering_report",
    merge_tool = ":clustering_report_merge_tool",
    tool = ":families_tool",
)

# The family edges of every clustered world (`edges_<key>`: family pairs with
# multiplicity and one contribution row per exact world edge) and its Atlas
# Live export (`export_<key>`, staged by //web/atlas-live/projection:families
# into data/<digest>/), with the report, the table and edge laws, and the
# cross-layer parity law against the web projection staging.
EXPORT_LAWS = families_exports(
    name = "export_report",
    staging = "//web/atlas-live/projection:families",
    tool = ":families_tool",
)

flix_check(
    name = "families_check",
    srcs = [
        "AcquisitionTest.flix",
        "ClusterTest.flix",
        "EdgeTest.flix",
        "FamiliesTest.flix",
        ":families_closure",
        "//test:TestWorlds.flix",
    ],
    command = "test",
    java_deps = [
        "//src/native/identity:attune_identity",
        "//src/native/inference:attune_inference",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

checked_test(
    name = "families_test",
    check = ":families_check",
)

# The charter law: the repo AGENTS.md carries the dated, scoped acquisition-zone
# carve-out beside the unchanged no-reacquisition paragraph, and REPORT.md
# carries the charter sections.
sh_test(
    name = "charter_test",
    size = "small",
    srcs = ["charter_test.sh"],
    data = [
        "REPORT.md",
        "//:AGENTS.md",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# The report law: every inventory number in REPORT.md is the regenerated
# projection of the typed inventory tables, byte for byte.
sh_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.sh"],
    data = [
        "PROTOCOL.md",
        "REPORT.md",
        ":acquisition_report",
        ":clustering_report",
        ":export_report",
        ":inventory_report",
        ":method_constants",
        ":protocol_constants",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# The issue-blindness law runs once per acquired world under one suite name:
# the tool's sources name no Localization, issue, or gold input, and every
# retained request is a families state or document batch naming none of them.
families_issue_blindness_tests(
    name = "issue_blindness_test",
    evidence = ACQUIRED_EVIDENCE,
)

# Research law surface for the families experiment; aggregated by the root
# `tests` suite.
test_suite(
    name = "families_tests",
    tests = [
        ":charter_test",
        ":families_test",
        ":issue_blindness_test",
        ":report_test",
    ] + CLUSTERING_LAWS + EXPORT_LAWS,
)
