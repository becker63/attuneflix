load("//build:flix.bzl", "flix_fatjar")
load("//build:attune.bzl", "attune_atlas_signature", "attune_world_fixture")

flix_fatjar(
    name = "signature_flix",
    srcs = [
        "Main.flix",
        "//build:src/AtlasRepository.flix",
        "//src:Atlas.flix",
        "//src:Atlas/Signature.flix",
        "//src:Atlas/Signature/Table.flix",
        "//src:Radii.flix",
        "//src:Repository/Physical.flix",
        "//src:Repository/Table.flix",
        "//src:Repository/Structure.flix",
        "//src:ScientificIdentity.flix",
        "//src:ScientificTable.flix",
    ],
    java_deps = [
        "//src/native/identity:attune_identity",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

java_binary(
    name = "signature",
    jvm_flags = [
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--enable-native-access=ALL-UNNAMED",
    ],
    main_class = "Main",
    runtime_deps = [":signature_flix"],
)

genrule(
    name = "protocol",
    srcs = [],
    outs = ["protocol.txt"],
    cmd = "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin $(location :signature) --jvm_flag=-Dattune.command=protocol > $@",
    tools = [":signature"],
)

attune_world_fixture(
    name = "world_fixture",
    base_revision = "fixture-revision",
    fact_identity = "repository-facts-v2:fixture",
    repository = "attune/fixture",
    snapshot_id = "repository-snapshot-v1:fixture",
    source_tree_identity = "source-tree-v1:fixture",
    tool = ":signature",
)

attune_atlas_signature(
    name = "signature_fixture",
    tool = ":signature",
    world = ":world_fixture",
)
