load(":artifacts.bzl", "attune_artifact_boundary_test", "attune_control_stage")
load(":control_signatures.bzl", "attune_control_signature_artifacts_test", "attune_control_signature_check", "attune_control_signatures")
load(":round_topology.bzl", "attune_round_artifacts_test", "attune_round_check", "attune_round_reproducibility_test", "attune_round_topology")
load(":topology.bzl", "attune_control_topology", "attune_control_topology_artifacts_test", "attune_control_topology_check")
load(":work_topology.bzl", "attune_control_acquisition", "attune_control_reproducibility_test")

package(default_visibility = ["//visibility:public"])

# The frozen control evidence (§2, §3, §6, §8, §9, §14). Committed under
# control/; read-only typed Parquet, the identity map, and the frozen topology
# and co-change documents, never hand-edited.
#
# Round 4 declares the evidence as four *typed artifact boundaries*, one per
# stage that produces it, instead of one 10-file list (K4 Hill-Climb Round 4,
# PREREGISTRATION.md §7/§14). A consumer declares the boundary it actually
# reads, so a change to one stage's artifact no longer invalidates the
# consumers of another stage's:
#
#   world      acquisition (`acquire`)                 attuneflix-grit-{sources,facts}-v2
#   signature  depth 1..7 signature stage              attune-atlas-signature-{observations,summary}-v1
#   topology   work-topology / co-change stage         (frozen documents)
#   locality   Build channel (`measure_bazel_locality.sh`)
#
# `control_files` stays as the union so one label still names the whole frozen
# record (the report and the round bookkeeping read it that way).
filegroup(
    name = "control_world_artifacts",
    srcs = [
        "control/control.facts.parquet",
        "control/control.files.txt",
        "control/control.revision.txt",
        "control/control.sources.parquet",
    ],
)

filegroup(
    name = "control_signature_artifacts",
    srcs = [
        "control/control.identity_map.json",
        "control/control.signatures.parquet",
        "control/control.summaries.parquet",
    ],
)

filegroup(
    name = "control_topology_artifacts",
    srcs = [
        "control/control.cochange.json",
        "control/control.cochange_history.txt",
        "control/control.topology.json",
    ],
)

filegroup(
    name = "control_locality_artifacts",
    srcs = [
        "control/control.fanout.txt",
        "control/control.targets.txt",
        "control/control.tests.txt",
    ],
)

filegroup(
    name = "control_files",
    srcs = [
        ":control_locality_artifacts",
        ":control_signature_artifacts",
        ":control_topology_artifacts",
        ":control_world_artifacts",
    ],
)

exports_files([
    "scripts/fanout_delta.sh",
    "scripts/measure_bazel_locality.sh",
])

# The Round 1 candidate measurement (PREREGISTRATION.md §9, §10; VAL-HC1-003).
# `round1.files.txt` is the round-1 revision's admitted path list derived by the
# one §2 admission rule; `round1.sources.txt` is that revision's source-hash
# manifest (no Grit, no fact re-acquisition); the three JSON documents are the
# round's identity map, static work-topology and signature-preservation oracle.
# The Bazel-locality artifacts are produced by `scripts/measure_bazel_locality.sh
# round1` (targets, tests, per-file direct fanout) and `scripts/fanout_delta.sh
# control round1` (the comparative table keyed on the logical identity layer).
filegroup(
    name = "round1_files",
    srcs = [
        "round1/round1.fanout.txt",
        "round1/round1.fanout_delta.tsv",
        "round1/round1.files.txt",
        "round1/round1.identity_map.json",
        "round1/round1.oracle.json",
        "round1/round1.revision.txt",
        "round1/round1.sources.txt",
        "round1/round1.targets.txt",
        "round1/round1.tests.txt",
        "round1/round1.topology.json",
    ],
)

# Rounds 2 and 3 candidate measurements (PREREGISTRATION.md §9, §10;
# VAL-HC23-003, VAL-HC23-004). Same instrument and artifacts as round 1, at the
# round-2 revision 10f3a21 (narrow cell crossings) and the round-3 revision
# 73b8709 (shared build/law-surface stabilization). `round2/` additionally
# records the round-2 revision's declared `src/BUILD.bazel` comment in its
# oracle verdicts (O4 false); see `rounds/round23.md`.
filegroup(
    name = "round2_files",
    srcs = [
        "round2/round2.fanout.txt",
        "round2/round2.fanout_delta.tsv",
        "round2/round2.files.txt",
        "round2/round2.identity_map.json",
        "round2/round2.oracle.json",
        "round2/round2.revision.txt",
        "round2/round2.sources.txt",
        "round2/round2.targets.txt",
        "round2/round2.tests.txt",
        "round2/round2.topology.json",
    ],
)

filegroup(
    name = "round3_files",
    srcs = [
        "round3/round3.fanout.txt",
        "round3/round3.fanout_delta.tsv",
        "round3/round3.files.txt",
        "round3/round3.identity_map.json",
        "round3/round3.oracle.json",
        "round3/round3.revision.txt",
        "round3/round3.sources.txt",
        "round3/round3.targets.txt",
        "round3/round3.tests.txt",
        "round3/round3.topology.json",
    ],
)

# `bazel run //experiments/atlas-work-topology:acquire` materializes the control
# revision in an isolated /tmp worktree and freezes the typed evidence.
attune_control_acquisition()

# `bazel test //experiments/atlas-work-topology:control_reproducibility_test`
# re-acquires the same worktree and asserts byte-for-byte equality.
attune_control_reproducibility_test()

# `bazel run //experiments/atlas-work-topology:compute_control_signatures`
# re-admits the committed control evidence, evaluates the frozen depth-7 Atlas
# family over the frozen seed panel, and writes the typed signature tables and
# the logical identity map (§3, §9).
attune_control_signatures()

# Provenance and protocol law tests for the signature instrument (§3, §14).
attune_control_signature_check()

# `bazel test //experiments/atlas-work-topology:control_signature_artifacts_test`
# independently re-derives the landmarks and identity map from the committed
# evidence and compares them with the committed artifacts (§3, §9).
attune_control_signature_artifacts_test()

# `bazel run //experiments/atlas-work-topology:measure_control_topology`
# freezes the co-change raw extract from the VCS history, re-admits the
# committed control evidence, and writes `control.topology.json` (cuts k=2..10,
# the K4 ownership-cell cut, coherence, hotspots, overlap, blast) and
# `control.cochange.json` (§6, §8).
attune_control_topology()

# The two expensive scientific stages as declared, cacheable Bazel actions
# (K4 Hill-Climb Round 4; PREREGISTRATION.md §7, §14; VAL-HC4-001).
#
# Each stage is a pure function of the frozen typed evidence, so it is declared
# with exactly that evidence as its inputs and its typed artifacts as declared
# outputs. They are the artifact boundaries downstream consumers read:
#
#   bazel build //experiments/atlas-work-topology:control_signature_tables \
#               //experiments/atlas-work-topology:control_topology_documents \
#               --config=buildbuddy-rbe
#
# A second invocation reuses the action cache (`N remote cache hit`) because
# nothing either stage reads has changed. The `bazel run` commands of record
# above still write the committed evidence; these actions derive the same
# artifacts into the build graph without touching the source tree.
attune_control_stage(
    name = "control_signature_tables",
    evidence = [":control_world_artifacts"],
    stage = "signatures",
    tool = ":control_signatures_bin",
)

attune_control_stage(
    name = "control_topology_documents",
    evidence = [
        ":control_world_artifacts",
        "control/control.cochange_history.txt",
    ],
    stage = "topology",
    tool = ":control_topology_bin",
)

# `bazel test //experiments/atlas-work-topology:artifact_boundary_test` is the
# in-graph downstream consumer of those declared artifacts: it checks every
# declared stage output against the committed frozen evidence, so the boundary
# is only reused when it re-derives the frozen bytes exactly.
attune_artifact_boundary_test()

# Provenance and protocol law tests for the topology instrument (§4, §5, §6, §8).
attune_control_topology_check()

# `bazel test //experiments/atlas-work-topology:control_topology_artifacts_test`
# independently re-derives both documents from the committed evidence and
# compares them with the committed artifacts (§6, §8).
attune_control_topology_artifacts_test()

# `bazel run //experiments/atlas-work-topology:measure_topology -- round1`
# writes the Round 1 candidate's identity map, static work-topology and
# signature-preservation oracle over the frozen control basis (§9, §10, §11).
attune_round_topology()

# Provenance and protocol law tests for the round instrument (§4, §5, §9, §11).
attune_round_check()

# `bazel test //experiments/atlas-work-topology:round1_artifacts_test`
# independently re-derives the round's identity map, topology and oracle from
# the committed evidence and compares them with the committed artifacts.
attune_round_artifacts_test()

# `bazel test //experiments/atlas-work-topology:round3_artifacts_test`
# the same full `attune.command=verify` guard for the round-3 revision (its
# verdict set passes: `src/BUILD.bazel` is restored byte-identically).
attune_round_artifacts_test(name = "round3_artifacts_test", role = "round3")

# `bazel test //experiments/atlas-work-topology:round2_reproducibility_test`
# re-derives the round-2 documents and compares them byte-for-byte. The full
# verdict set is not asserted for round 2 because its revision's `src/BUILD.bazel`
# comment trips the implemented (over-broad) production-drift proxy; the
# recorded `O4 = false` nevertheless stays pinned by the byte-equality diff.
attune_round_reproducibility_test(name = "round2_reproducibility_test", role = "round2")

# Cell D — Research law surface: one aggregation point for the research cell's
# replay, signature-provenance, and topology-provenance laws. The frozen
# historical instrument's provenance law is aggregated here unchanged.
test_suite(
    name = "research_tests",
    tests = [
        ":artifact_boundary_test",
        ":control_reproducibility_test",
        ":control_signature_artifacts_test",
        ":control_signature_test",
        ":control_topology_artifacts_test",
        ":control_topology_test",
        ":round1_artifacts_test",
        ":round2_reproducibility_test",
        ":round3_artifacts_test",
        ":round_test",
        "//experiments/atlas-parallelism:parallelism_provenance_test",
    ],
)
