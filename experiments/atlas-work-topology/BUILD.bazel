load(":control_signatures.bzl", "attune_control_signature_artifacts_test", "attune_control_signature_check", "attune_control_signatures")
load(":round_topology.bzl", "attune_round_artifacts_test", "attune_round_check", "attune_round_topology")
load(":topology.bzl", "attune_control_topology", "attune_control_topology_artifacts_test", "attune_control_topology_check")
load(":work_topology.bzl", "attune_control_acquisition", "attune_control_reproducibility_test")

package(default_visibility = ["//visibility:public"])

# The frozen control evidence (§2, §3, §6, §8, §9, §14). Committed under
# control/; read-only typed Parquet, the identity map, and the frozen topology
# and co-change documents, never hand-edited.
filegroup(
    name = "control_files",
    srcs = [
        "control/control.cochange.json",
        "control/control.cochange_history.txt",
        "control/control.facts.parquet",
        "control/control.files.txt",
        "control/control.identity_map.json",
        "control/control.revision.txt",
        "control/control.signatures.parquet",
        "control/control.sources.parquet",
        "control/control.summaries.parquet",
        "control/control.topology.json",
    ],
)

exports_files([
    "scripts/fanout_delta.sh",
    "scripts/measure_bazel_locality.sh",
])

# The Round 1 candidate measurement (PREREGISTRATION.md §9, §10; VAL-HC1-003).
# `round1.files.txt` is the round-1 revision's admitted path list derived by the
# one §2 admission rule; `round1.sources.txt` is that revision's source-hash
# manifest (no Grit, no fact re-acquisition); the three JSON documents are the
# round's identity map, static work-topology and signature-preservation oracle.
# The Bazel-locality artifacts are produced by `scripts/measure_bazel_locality.sh
# round1` (targets, tests, per-file direct fanout) and `scripts/fanout_delta.sh
# control round1` (the comparative table keyed on the logical identity layer).
filegroup(
    name = "round1_files",
    srcs = [
        "round1/round1.fanout.txt",
        "round1/round1.fanout_delta.tsv",
        "round1/round1.files.txt",
        "round1/round1.identity_map.json",
        "round1/round1.oracle.json",
        "round1/round1.revision.txt",
        "round1/round1.sources.txt",
        "round1/round1.targets.txt",
        "round1/round1.tests.txt",
        "round1/round1.topology.json",
    ],
)

# `bazel run //experiments/atlas-work-topology:acquire` materializes the control
# revision in an isolated /tmp worktree and freezes the typed evidence.
attune_control_acquisition()

# `bazel test //experiments/atlas-work-topology:control_reproducibility_test`
# re-acquires the same worktree and asserts byte-for-byte equality.
attune_control_reproducibility_test()

# `bazel run //experiments/atlas-work-topology:compute_control_signatures`
# re-admits the committed control evidence, evaluates the frozen depth-7 Atlas
# family over the frozen seed panel, and writes the typed signature tables and
# the logical identity map (§3, §9).
attune_control_signatures()

# Provenance and protocol law tests for the signature instrument (§3, §14).
attune_control_signature_check()

# `bazel test //experiments/atlas-work-topology:control_signature_artifacts_test`
# independently re-derives the landmarks and identity map from the committed
# evidence and compares them with the committed artifacts (§3, §9).
attune_control_signature_artifacts_test()

# `bazel run //experiments/atlas-work-topology:measure_control_topology`
# freezes the co-change raw extract from the VCS history, re-admits the
# committed control evidence, and writes `control.topology.json` (cuts k=2..10,
# the K4 ownership-cell cut, coherence, hotspots, overlap, blast) and
# `control.cochange.json` (§6, §8).
attune_control_topology()

# Provenance and protocol law tests for the topology instrument (§4, §5, §6, §8).
attune_control_topology_check()

# `bazel test //experiments/atlas-work-topology:control_topology_artifacts_test`
# independently re-derives both documents from the committed evidence and
# compares them with the committed artifacts (§6, §8).
attune_control_topology_artifacts_test()

# `bazel run //experiments/atlas-work-topology:measure_topology -- round1`
# writes the Round 1 candidate's identity map, static work-topology and
# signature-preservation oracle over the frozen control basis (§9, §10, §11).
attune_round_topology()

# Provenance and protocol law tests for the round instrument (§4, §5, §9, §11).
attune_round_check()

# `bazel test //experiments/atlas-work-topology:round1_artifacts_test`
# independently re-derives the round's identity map, topology and oracle from
# the committed evidence and compares them with the committed artifacts.
attune_round_artifacts_test()

# Cell D — Research law surface: one aggregation point for the research cell's
# replay, signature-provenance, and topology-provenance laws. The frozen
# historical instrument's provenance law is aggregated here unchanged.
test_suite(
    name = "research_tests",
    tests = [
        ":control_reproducibility_test",
        ":control_signature_artifacts_test",
        ":control_signature_test",
        ":control_topology_artifacts_test",
        ":control_topology_test",
        ":round1_artifacts_test",
        ":round_test",
        "//experiments/atlas-parallelism:parallelism_provenance_test",
    ],
)
