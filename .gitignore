# Retained local evidence and credentials
/.attune/*
!/.attune/BUILD.bazel
!/.attune/repository-world-v1/
!/.attune/repository-world-v1/**
# One pinned, immutable AttuneFlix self-world. Its three small typed basis
# tables are the declared source input for BuildBuddy-derived view artifacts.
!/.attune/atlas-live-self-v1/
!/.attune/atlas-live-self-v1/**
# Atlas Families: keep small Starlark package declarations in git so Bazel can
# address each world, while new raw/typed evidence stays local and git-ignored.
# Preact's already-tracked exemplar remains tracked without rewriting history.
!/.attune/families-embeddings-v1/
!/.attune/families-embeddings-v1/*/
/.attune/families-embeddings-v1/*/*
!/.attune/families-embeddings-v1/*/BUILD.bazel
!/.attune/jev-families-raw-v1/
!/.attune/jev-families-raw-v1/*/
/.attune/jev-families-raw-v1/*/*
!/.attune/jev-families-raw-v1/*/BUILD.bazel
/.env
/.env.*
!/.env.example

# Nix, Flix, and Bazel outputs
/result
/result-*
/artifact/
*.fpkg
/bazel-attuneflix
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-remote-grpc.log
/execution_log.binpb.zst

# Vercel CLI project link state (the deploy links through a temp copy)
/.vercel/

# rules_rust crate-universe projections for Grit path dependencies. The
# authoritative BUILD definitions live in build/grit_repository.bzl.
/resources/language-metavariables/tree-sitter-javascript/BUILD.bazel
/resources/language-metavariables/tree-sitter-typescript/BUILD.bazel
/vendor/tree-sitter-facade/BUILD.bazel
/vendor/tree-sitter-gritql/BUILD.bazel
/vendor/web-tree-sitter/BUILD.bazel

# npm trees are Bazel outputs (rules_js); none belongs in the source tree.
node_modules/

# Rust/Zed build output
/src/native/grit/target/
/zed/target/
/zed/extension.wasm
/zed/grammars/

# Python/editor/OS residue
/.venv
/.direnv/
__pycache__/
*.py[cod]
.DS_Store
*.swp
*~

# Local diagnostics and generated inspection packs
/crash_report_*.txt
/repomix-output.*
/experiments/**/logs/
