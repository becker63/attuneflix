# Cell A — World law surface.
#
# Owns the World cell's own law targets. The two fixtures shared with other
# cells' laws (the `mod Repository {}` parent anchor and the `TestWorlds` a/b
# world) live on the horizontal law surface (`//test`), not here, so no other
# cell's law package reads into this one (Round 2).
load("//test/build:flix.bzl", "checked_test", "flix_check", "flix_loc_law")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "flix_sources",
    srcs = glob(["*.flix"]),
)

# The World cell's slice of the Flix LOC law (VAL-METRIC-002): the admitted-world
# implementation, the native acquisition seam, the typed Acquire/World stage
# nodes, and this cell's laws.
flix_loc_law(
    name = "flix_loc_law_test",
    srcs = [
        "//src/world:flix_sources",
        "//src/stage/acquire:flix_sources",
        "//src/stage/world:flix_sources",
        ":flix_sources",
    ],
    max_total = 1515,
)

flix_check(
    name = "repository_admission_check",
    srcs = [
        "RepositoryAdmissionTest.flix",
        "//test:stage_world_law_sources",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "repository_admission_test",
    check = ":repository_admission_check",
)

flix_check(
    name = "grit_acquisition_check",
    srcs = [
        "GritAcquisitionTest.flix",
        "//test:world_admission_law_sources",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "grit_acquisition_test",
    check = ":grit_acquisition_check",
)

# Stage 1 acquisition (VAL-STAGE-001): the typed `Stage.Acquire` stage is
# exercised by an in-memory `eff Grit` handler, so the law runs keyless and
# carries no native dependency.
flix_check(
    name = "grit_acquire_check",
    srcs = [
        "AcquireTest.flix",
        "//test:stage_acquire_law_sources",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "grit_acquire_test",
    check = ":grit_acquire_check",
)

# The low-level native Grit dispatch seam (`Repository.Acquire.evaluate`) is
# retained for the frozen acquisition instrument and needs the native engine, so
# it stays a `check`-only native target; the typed stage above it is what carries
# the behaviour. It reads the seam through its owning stage package
# (`//src/world:acquire`), not the raw `//src` file labels, so the source is
# declared by exactly one stage package.
flix_check(
    name = "acquire_seam_check",
    srcs = ["//src/world:acquire"],
    command = "check",
    java_deps = ["//src/native/grit:attune_grit"],
    threads = 2,
)

checked_test(
    name = "acquire_seam_test",
    check = ":acquire_seam_check",
)

flix_check(
    name = "repository_table_check",
    srcs = [
        "RepositoryTableTest.flix",
        "//src:Repository/Table.flix",
        "//test:kernel_identity_law_sources",
        "//test:kernel_table_transport_law_sources",
        "//test:world_admission_law_sources",
        "//src:Kernel/Effect.flix",
        "//src:Kernel/DigestHandler.flix",
    ],
    command = "test",
    java_deps = [
        "//src/native/identity:attune_identity",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

checked_test(
    name = "repository_table_test",
    check = ":repository_table_check",
)

# Candidate B: the production capability handler over the real native Grit
# engine (AttuneGrit) and identity seam. This is where VAL-EFF-002's
# `//test/World:*` tool surface actually bridges algebraic capabilities to
# native FFI, not just fixture data.
flix_check(
    name = "handler_production_check",
    srcs = [
        "HandlerProductionTest.flix",
        "//src:Kernel.flix",
        "//src:Kernel/Contract.flix",
        "//src:Kernel/Effect.flix",
        "//src:Kernel/Handler.flix",
        "//src:Kernel/DigestHandler.flix",
        "//src:Repository.flix",
        "//src:Repository/Grit.flix",
        "//src:Repository/Structure.flix",
        "//test:kernel_table_transport_law_sources",
    ],
    command = "test",
    java_deps = [
        "//src/native/grit:attune_grit",
        "//src/native/identity:attune_identity",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

checked_test(
    name = "handler_production_test",
    check = ":handler_production_check",
)

test_suite(
    name = "world_tests",
    tests = [
        ":acquire_seam_test",
        ":grit_acquire_test",
        ":grit_acquisition_test",
        ":handler_production_test",
        ":repository_admission_test",
        ":repository_table_test",
        "//src/native/grit:attune_grit_rust_test",
        "//src/native/grit:attune_grit_test",
    ],
)
