# The law surface's shared fixtures and its DAG-composed cell source catalogs.
#
# Candidate D re-homed every production source catalog onto the stage packages
# (`//src/kernel`, `//src/transport/parquet`, `//src/world`, `//src/engine`,
# `//src/applications`, `//src/stage/*`). A cell's law surface now composes the
# stage closures it actually reads instead of repeating `//src` file labels, so
# each production source is declared by exactly one stage package and a
# stage-local edit invalidates only the law targets whose stage closure contains
# it. This package owns no test target: law targets belong to their cell.
load("//test/build:flix.bzl", "flix_loc_law")

package(default_visibility = ["//visibility:public"])

# The two fixtures read by more than one cell's laws (the reduced
# `mod Repository {}` parent anchor and the `TestWorlds` a/b world) live on the
# horizontal law surface, so no cell's law package reaches into another cell's
# law internals.
exports_files([
    "Repository.flix",
    "TestWorlds.flix",
])

# ---- World cell law catalogs ------------------------------------------------

# The reduced relational surface: `Repository.Structure` plus the empty
# `mod Repository {}` parent anchor it compiles against.
filegroup(
    name = "world_structure_law_sources",
    srcs = [
        "//src/kernel:contract",
        "//src/world:structure",
    ],
)

# `Repository.Reference` (the Datalog reference meaning) over the relational
# surface.
filegroup(
    name = "world_relational_law_sources",
    srcs = [
        ":world_structure_law_sources",
        "//src:Repository/Reference.flix",
    ],
)

# The full admission surface: the World vocabulary, call index, and per-language
# rules.
filegroup(
    name = "world_admission_law_sources",
    srcs = [
        "//src/kernel:contract",
        "//src/world:admission",
    ],
)

# Stage 1 `Acquire`: the typed acquisition node over `eff Grit`, the pure Grit
# fact vocabulary, and the stage namespace anchor.
filegroup(
    name = "stage_acquire_law_sources",
    srcs = [
        "//src/kernel:effect",
        "//src/stage:flix_sources",
        "//src/stage/acquire:flix_sources",
        "//src/world:grit",
    ],
)

# Stage 2 `World`: the typed admission node.
filegroup(
    name = "stage_world_law_sources",
    srcs = [
        "//src/kernel:contract",
        "//src/stage:flix_sources",
        "//src/stage/world:flix_sources",
        "//src/world:admission",
    ],
)

# ---- Engine cell law catalogs -----------------------------------------------

filegroup(
    name = "engine_physical_law_sources",
    srcs = ["//src/engine:physical"],
)

filegroup(
    name = "engine_radii_law_sources",
    srcs = ["//src/engine:radii"],
)

filegroup(
    name = "engine_atlas_law_sources",
    srcs = [
        "//src/engine:atlas",
        "//src/kernel:effect",
    ],
)

# Stage 3B `Atlas`: the Atlas grammar, the relation algebra, the physical
# evaluator, the kernel contract, and the stage namespace anchor.
filegroup(
    name = "stage_atlas_law_sources",
    srcs = [
        "//src/engine:atlas",
        "//src/engine:physical",
        "//src/engine:radii",
        "//src/kernel:contract",
        "//src/stage:flix_sources",
        "//src/stage/atlas:flix_sources",
        "//src/world:anchor",
    ],
)

# Stage 3A `Prior`: pure over the declared `eff Embedding`.
filegroup(
    name = "stage_prior_law_sources",
    srcs = [
        "//src/kernel:effect",
        "//src/stage:flix_sources",
        "//src/stage/prior:flix_sources",
    ],
)

# ---- Applications cell law catalogs -----------------------------------------

# Stage 4/5: candidate assembly and judge selection over Prior.
filegroup(
    name = "stage_candidate_judge_law_sources",
    srcs = [
        ":stage_prior_law_sources",
        "//src/stage/candidate_set:flix_sources",
        "//src/stage/judge:flix_sources",
    ],
)

# Stage 6: context projection.
filegroup(
    name = "stage_projection_law_sources",
    srcs = [
        "//src/kernel:contract",
        "//src/stage:flix_sources",
        "//src/stage/projection:flix_sources",
    ],
)

# The composed 3-6 pipeline: Prior, Atlas, CandidateSet, Judge, and Projection.
filegroup(
    name = "stage_pipeline_law_sources",
    srcs = [
        ":stage_atlas_law_sources",
        ":stage_candidate_judge_law_sources",
        "//src/stage/pipeline:flix_sources",
        "//src/stage/projection:flix_sources",
    ],
)

# ---- Kernel cell law catalogs -----------------------------------------------

filegroup(
    name = "kernel_contract_law_sources",
    srcs = ["//src/kernel:contract"],
)

filegroup(
    name = "kernel_effect_law_sources",
    srcs = ["//src/kernel:effect"],
)

filegroup(
    name = "kernel_identity_law_sources",
    srcs = ["//src/kernel:identity"],
)

filegroup(
    name = "kernel_table_law_sources",
    srcs = ["//src/kernel:schema"],
)

filegroup(
    name = "kernel_table_transport_law_sources",
    srcs = ["//src/transport/parquet:closure"],
)

filegroup(
    name = "kernel_handler_law_sources",
    srcs = ["//src/kernel:handler"],
)

# ---- The residual LOC law slice ---------------------------------------------

# The two shared fixtures. Every other law source is covered by its own cell's
# LOC law, so no single law target reaches across the stage DAG.
flix_loc_law(
    name = "flix_loc_law_test",
    srcs = [
        "Repository.flix",
        "TestWorlds.flix",
    ],
    max_total = 26,
)
