load("//build:flix.bzl", "checked_test", "flix_check")

flix_check(
    name = "core_parity_check",
    srcs = [
        "ParityTest.flix",
        "//build:src/Repository.flix",
        "//src:Radii.flix",
        "//src:Radii/Compiled.flix",
        "//src:Radii/Evaluate.flix",
        "//src:Radii/Synthesize.flix",
        "//src:Repository/Physical.flix",
        "//src:Repository/Reference.flix",
        "//src:Repository/Structure.flix",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "core_parity_test",
    check = ":core_parity_check",
)

flix_check(
    name = "inference_boundary_check",
    srcs = ["//build:src/InferenceBoundaryTest.flix"],
    command = "check",
    java_deps = ["//src/native/inference:attune_inference"],
    threads = 2,
)

checked_test(
    name = "inference_boundary_test",
    check = ":inference_boundary_check",
)

flix_check(
    name = "grit_boundary_check",
    srcs = [
        "//build:src/Repository.flix",
        "//src:Repository/Grit.flix",
    ],
    command = "check",
    java_deps = ["//src/native/grit:attune_grit"],
    threads = 2,
)

checked_test(
    name = "grit_boundary_test",
    check = ":grit_boundary_check",
)
