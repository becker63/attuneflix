# The law surface's shared cell source catalogs (K4 Hill-Climb Round 1).
#
# Every production source a cell's laws compile against is declared exactly
# once here, as the narrowest catalog that genuinely shares it; wider catalogs
# compose narrower ones instead of re-listing their files. The cell law
# packages (`//test/World`, `//test/Engine`, `//test/Applications`,
# `//test/Kernel`) consume these catalogs rather than repeating `//src` labels
# in every target, so a source has one declaration and a change invalidates
# only the cells whose laws actually read it.
#
# This package owns no test target: law targets belong to their cell.

# Cell public surfaces (K4 Hill-Climb Round 2; re-homed here in Round 3).
#
# Flix has no top-level module privacy, so a cell's intentional cross-cell
# surface is declared here rather than enforced by the compiler. A cell exposes
# only the modules named below; every other module in the cell is internal
# implementation and is read only by that cell's own laws (and, for Cell D, by
# the instrument).
#
#   stable kernel : ScientificIdentity, Scientific.Schema, Scientific.Value,
#                   Scientific.Row, Scientific.Parquet
#                   (the Parquet/Arrow seam is the one kernel-stage transport;
#                    the schema/value/row modules are pure and carry no IO)
#   cell A world  : Repository, Repository/Structure
#                   (internal: Repository/Grit, Repository/Acquire,
#                    Repository/Reference, Repository/Table)
#   cell B engine : Radii, Atlas
#                   (internal: Repository/Physical, Radii/Evaluate,
#                    Radii/Synthesize, Atlas/Signature*)
#   cell C apps   : Localization, Population
#                   (internal: Localization/*Table, Population/Table)
#   cell D research: Experiment
#
# The cross-cell reads in the tree already respect this table: Engine and
# Applications reach only World/Kernel surfaces, and the only read of a cell
# internal across a cell boundary is by the Cell D instrument, which is a leaf.
# The World `Repository.Reference` -> Engine `Radii` read is the permanent
# reference/physical parity pair (the reference evaluator interprets Radii
# programs).
#
# Round 3 moved this declaration off `src/BUILD.bazel`: a production surface
# file must stay byte-stable across rounds (the oracle's production-drift rule),
# so the declared contract lives on the law surface that owns the per-cell
# catalogs.

package(default_visibility = ["//visibility:public"])

# Every tracked law Flix source in `//test`, for the LOC law
# (`//:flix_loc_law_test`). Composed from this package's own files and the four
# cell law packages' `flix_sources` filegroups.
filegroup(
    name = "flix_sources",
    srcs = glob(["*.flix"]) + [
        "//test/Applications:flix_sources",
        "//test/Engine:flix_sources",
        "//test/Kernel:flix_sources",
        "//test/World:flix_sources",
    ],
)

# The shared law surface (K4 Hill-Climb Round 2). Two fixtures are read by the
# law tests of more than one cell, so they are owned by the horizontal law
# surface rather than by any single cell: the reduced `mod Repository {}`
# parent anchor the Engine parity law compiles `Repository/Reference.flix`
# against, and the `TestWorlds` a/b fixture the Engine and Applications law
# surfaces read. Keeping them here means no cell's law package reaches into
# another cell's law internals.
exports_files([
    "Repository.flix",
    "TestWorlds.flix",
])

# World — the reduced relational surface (`Repository/Structure.flix` compiles
# against a declared parent module) and the full admission surface.
filegroup(
    name = "world_structure_law_sources",
    srcs = [
        "//src:Kernel.flix",
        "//src:Kernel/Contract.flix",
        "//src:Repository/Structure.flix",
    ],
)

filegroup(
    name = "world_relational_law_sources",
    srcs = [
        ":world_structure_law_sources",
        "//src:Repository/Reference.flix",
    ],
)

filegroup(
    name = "world_admission_law_sources",
    srcs = [
        ":world_structure_law_sources",
        "//src:Repository.flix",
        "//src:Repository/Grit.flix",
    ],
)

# Engine — the physical evaluator, the relation algebra, and the Atlas family.
filegroup(
    name = "engine_physical_law_sources",
    srcs = ["//src:Repository/Physical.flix"],
)

filegroup(
    name = "engine_radii_law_sources",
    srcs = [
        "//src:Radii.flix",
        "//src:Radii/Evaluate.flix",
        "//src:Radii/Synthesize.flix",
    ],
)

filegroup(
    name = "engine_atlas_law_sources",
    srcs = [
        "//src:Atlas.flix",
        "//src:Atlas/Signature.flix",
        "//src:Kernel/Effect.flix",
    ],
)

# Kernel — the move-stable identity and pure table contracts.
filegroup(
    name = "kernel_identity_law_sources",
    srcs = ["//src:ScientificIdentity.flix"],
)

# The pure scientific schema/row semantics. No `java_deps` is needed to compile
# this catalog, which is what proves the schema/transport separation
# (VAL-DECOMP-001): the schema and row meaning carry no native seam.
filegroup(
    name = "kernel_table_law_sources",
    srcs = [
        "//src:Kernel.flix",
        "//src:Kernel/Contract.flix",
        "//src:Scientific.flix",
        "//src:Scientific/Row.flix",
        "//src:Scientific/Schema.flix",
        "//src:Scientific/Value.flix",
    ],
)

# The isolated Parquet/Arrow transport. Only a target that actually performs
# table I/O declares this wider catalog (and the native transport dependency).
filegroup(
    name = "kernel_table_transport_law_sources",
    srcs = [
        ":kernel_table_law_sources",
        "//src:Scientific/Parquet.flix",
    ],
)

# Kernel — the Candidate A contract surface. The pure contract kernel declares
# the nominal IDs, relation types, six-atom Atlas grammar, scientific schema,
# and stage ADTs; its law compiles the module in isolation, which is what
# proves the zero-FFI / zero-IO / zero-resolver boundary (VAL-KERN-001/2/3).
filegroup(
    name = "kernel_contract_law_sources",
    srcs = [
        "//src:Kernel.flix",
        "//src:Kernel/Contract.flix",
    ],
)

# Kernel — the capability effect declarations (Candidate B). The effect module
# names only pure kernel types, so it inherits the same zero-FFI / zero-IO
# boundary as the contract: a target that compiles both with no `java_deps` is
# what proves the declarations delegate all real work to a handler
# (VAL-EFF-001).
filegroup(
    name = "kernel_effect_law_sources",
    srcs = [
        ":kernel_contract_law_sources",
        "//src:Kernel/Effect.flix",
    ],
)
