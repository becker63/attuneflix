# Stable Kernel law surface.
#
# The K4 substrate (`ScientificIdentity`, the `Scientific.Schema`/`Value`/`Row`
# semantics, and the isolated `Scientific.Parquet` transport) is not one of the
# four cells: it is the high-fan-in, low-edit-frequency kernel every cell reads.
# Its laws (identity and typed-table round-trips, driven by the single native
# Parquet seam) are owned here so kernel edits invalidate only kernel laws.
load("//test/build:flix.bzl", "checked_test", "flix_check", "flix_loc_law")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "flix_sources",
    srcs = glob(["*.flix"]),
)

# The kernel's slice of the Flix LOC law (VAL-METRIC-002): the Stable Contract &
# Semantic Kernel, its Parquet/Arrow transport, and this cell's laws.
flix_loc_law(
    name = "flix_loc_law_test",
    srcs = [
        "//src/kernel:flix_sources",
        "//src/transport/parquet:flix_sources",
        ":flix_sources",
    ],
    max_total = 715,
)

flix_check(
    name = "identity_check",
    srcs = [
        "IdentityTest.flix",
        "//test:kernel_identity_law_sources",
    ],
    command = "test",
    java_deps = ["//src/native/identity:attune_identity"],
    threads = 2,
)

checked_test(
    name = "identity_test",
    check = ":identity_check",
)

# The pure scientific schema and row meaning: stated in Flix, compiled with NO
# `java_deps`. The absence of the native transport from this action is the
# schema/transport separation law (VAL-DECOMP-001 / VAL-KERN-002): the table
# meaning needs no FFI, no disk, and no Parquet.
flix_check(
    name = "scientific_table_check",
    srcs = [
        "ScientificTableTest.flix",
        "//test:kernel_table_law_sources",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "scientific_table_test",
    check = ":scientific_table_check",
)

# The one Parquet/Arrow transport seam, and its boundary law: the Arrow engine
# only ever moves the canonical payload Flix composes, so the wire contract is
# asserted here while the native engine itself is exercised by
# `//src/native/parquet:attune_parquet_test`.
flix_check(
    name = "parquet_transport_check",
    srcs = [
        "ParquetTransportTest.flix",
        "//test:kernel_table_transport_law_sources",
    ],
    command = "test",
    java_deps = ["//src/native/parquet:attune_parquet"],
    threads = 2,
)

checked_test(
    name = "parquet_transport_test",
    check = ":parquet_transport_check",
)

# Candidate A: the pure contract kernel. Compiled with no `java_deps`, which is
# how the kernel's zero-FFI, zero-IO, zero-resolver boundary is enforced.
flix_check(
    name = "contract_check",
    srcs = [
        "ContractTest.flix",
        "//test:kernel_contract_law_sources",
    ],
    command = "test",
    threads = 2,
)

checked_test(
    name = "contract_test",
    check = ":contract_check",
)

# Candidate B: the capability effect declarations. Typechecked with no
# `java_deps`, so the effects stay pure declarations (no FFI, no file, no
# provider) and the handler seam remains the only place the world enters
# (VAL-EFF-001). Behavioural replay laws arrive with `Kernel.Handler`.
flix_check(
    name = "effect_check",
    srcs = ["//test:kernel_effect_law_sources"],
    command = "check",
    threads = 2,
)

checked_test(
    name = "effect_test",
    check = ":effect_check",
)

# Candidate B: the production and replay handlers. Compiled with the three
# native seams as `java_deps`, which is how the production bridge to
# AttuneIdentity / AttuneGrit / Files and the delegated Parquet transport is
# enforced; the replay law runs entirely from in-memory fixtures (VAL-EFF-002/003).
flix_check(
    name = "handler_check",
    srcs = [
        "HandlerTest.flix",
        "//test:kernel_effect_law_sources",
        "//test:kernel_table_transport_law_sources",
        "//src:Kernel/Handler.flix",
        "//src:Kernel/DigestHandler.flix",
        "//src:Repository.flix",
        "//src:Repository/Grit.flix",
        "//src:Repository/Structure.flix",
    ],
    command = "test",
    java_deps = [
        "//src/native/grit:attune_grit",
        "//src/native/identity:attune_identity",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

checked_test(
    name = "handler_test",
    check = ":handler_check",
)

test_suite(
    name = "kernel_tests",
    tests = [
        ":identity_test",
        ":scientific_table_test",
        ":parquet_transport_test",
        ":contract_test",
        ":effect_test",
        ":handler_test",
        "//src/native/identity:attune_identity_test",
        "//src/native/parquet:attune_parquet_test",
    ],
)
