# Every tracked `src/` Flix source, for the root LOC law (VAL-LOC-007). `**`
# skips subpackages, which carry no Flix sources.
filegroup(
    name = "flix_sources",
    srcs = glob([
        "*.flix",
        "**/*.flix",
    ]),
    visibility = ["//:__pkg__"],
)
