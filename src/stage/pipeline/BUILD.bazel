# Composed stage: the full 3-6 pipeline (`//src/stage/pipeline:*`).
#
# `Stage.Pipeline` composes Prior, Atlas, CandidateSet, Judge, and Projection in
# one typed call over immutable world data and handler-supplied capabilities.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "flix_sources",
    srcs = ["//src:Stage/Pipeline.flix"],
)

filegroup(
    name = "closure",
    srcs = [
        "//src/stage/projection:closure",
        ":flix_sources",
    ],
)
