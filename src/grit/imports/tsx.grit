engine marzano(0.1)
language js(jsx)

// @dialect tsx
// TSX sources (.tsx) use the JSX/TSX parser. This explicit declaration replaces the historical runtime source rewrite that could report success under the wrong grammar.
// Grit returns syntax matches plus logged source values. Attune later assigns repository identities, resolves/admit edges, and derives inverse relations; this frontend does none of those jobs.

// @syntax source
//
// Static module dependencies.
//
// All of these match:
//
//   import { verify } from "./verify";
//
//   import {
//     verify,
//     validate,
//   } from "./verify";
//
//   import Client from "./client";
//
//   import * as auth from "./auth";
//
//   import type { User } from "./types";
//
//   import "./setup";
//
//   const verify = require("./verify");
//
// $source is the quoted module specifier:
//
//   "./verify"
//   "./client"
//   "./auth"
//   "./types"
//   "./setup"
//
// These do not match:
//
//   export { verify } from "./verify";
//   export * from "./verify";
//
//   const module = await import("./lazy");
//
// Grit leaves "./verify" as source text.
// Python later resolves it to a repository FileId.
//
// @example A type-only import is still a static file dependency.
// import type { User } from "./types";
// @end

or {
  `import $source`,
  `require($source)`
} as $import where {
  log(message="import", variable=$source)
}

