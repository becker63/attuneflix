#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/../../.." && pwd)
cd "$root"

jar_file="$root/.build/parquet/attune-parquet.jar"
root_link="$root/.build/parquet/nix-root"
package=$(nix build path:.#attune-parquet-jar --out-link "$root_link" --print-out-paths)

install -Dm644 "$package/share/java/attune-parquet.jar" "$jar_file"
install -Dm644 "$jar_file" lib/external/attune-parquet.jar

mkdir -p .build/parquet/test-classes
javac \
  --release 21 \
  -cp "$jar_file" \
  -d .build/parquet/test-classes \
  src/native/parquet/AttuneParquetTest.java
