load("//build:flix.bzl", "flix_fatjar")

flix_fatjar(
    name = "migrate_flix",
    srcs = [
        "Main.flix",
        "//src:Repository.flix",
        "//src:Repository/Grit.flix",
        "//src:Repository/Table.flix",
        "//src:Repository/Structure.flix",
        "//src:ScientificData.flix",
        "//src:ScientificIdentity.flix",
        "//src:ScientificTable.flix",
    ],
    java_deps = [
        "//src/native/grit:attune_grit",
        "//src/native/identity:attune_identity",
        "//src/native/parquet:attune_parquet",
    ],
    threads = 2,
)

java_binary(
    name = "migrate",
    jvm_flags = [
        "-Xmx8g",
        "-Xss16m",
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--enable-native-access=ALL-UNNAMED",
    ],
    main_class = "Main",
    runtime_deps = [":migrate_flix"],
    visibility = ["//visibility:public"],
)
