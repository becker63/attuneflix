load("//build:flix.bzl", "flix_fatjar")

flix_fatjar(
    name = "migration_flix",
    srcs = [
        "Main.flix",
        "//src:Population.flix",
        "//src:Population/Table.flix",
        "//src:ScientificTable.flix",
    ],
    java_deps = ["//src/native/parquet:attune_parquet"],
    threads = 2,
)

java_binary(
    name = "migration",
    jvm_flags = [
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--enable-native-access=ALL-UNNAMED",
    ],
    main_class = "Main",
    runtime_deps = [":migration_flix"],
)

genrule(
    name = "population",
    srcs = ["//experiments/swe-explore-js-ts-scale:MANIFEST.json"],
    outs = ["metadata.parquet", "cases.parquet"],
    cmd = " ".join([
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "$(location :migration)",
        "--jvm_flag=-Dattune.manifest=$(location //experiments/swe-explore-js-ts-scale:MANIFEST.json)",
        "--jvm_flag=-Dattune.population_metadata=$(@D)/metadata.parquet",
        "--jvm_flag=-Dattune.population_cases=$(@D)/cases.parquet",
    ]),
    tools = [":migration"],
)
