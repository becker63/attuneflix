module(
    name = "attuneflix",
    version = "0.1.0",
)

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_jar(
    name = "flix_compiler",
    sha256 = "d8d9a3870e199c03ed6364ea9430f56f67bfd38c332c411628a6a7cb88b2b0b4",
    urls = ["https://github.com/flix/flix/releases/download/v0.76.0/flix.jar"],
)

# Raw benchmark sources are evaluator/acquisition inputs, not solver inputs.
# They are lazy external repositories: ordinary build, test, replay, and Atlas
# targets do not download them. Revisions and hashes come from the frozen Nix
# acquisition oracle that Bazel replaced.
http_file(
    name = "swe_explore_dataset",
    downloaded_file_path = "bench.final.public.jsonl",
    sha256 = "dc4f114ececd0bfb987361c26ae5e2440456e2cccb36adfccb09ea5385aec202",
    urls = ["https://huggingface.co/datasets/SWE-Explore-Bench/SWE-Explore-Bench/resolve/bdb0ae45d7c337d9e1dc3ebfe2a0af6bc7c1fbd9/bench.final.public.jsonl"],
)

http_file(
    name = "swe_bench_multilingual_dataset",
    downloaded_file_path = "test-00000-of-00001.parquet",
    sha256 = "28b7f874e48496399077d276f9f2b163a077ddf0a70dc507c148d58da826baa9",
    urls = ["https://huggingface.co/datasets/SWE-bench/SWE-bench_Multilingual/resolve/7566cd247075886ef34453ff5582908c0255f5e6/data/test-00000-of-00001.parquet"],
)

http_file(
    name = "swe_bench_pro_dataset",
    downloaded_file_path = "test.csv",
    sha256 = "d2823b3c45341ac43586f49c9e49ee34f9fb10c4f5eddca40289750439513c2a",
    urls = ["https://huggingface.co/datasets/ScaleAI/SWE-bench_Pro/resolve/a3f0ce9b3057b4656c77656c0317a482d4bf9c20/test.csv"],
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")
bazel_dep(name = "llvm", version = "0.8.21")
bazel_dep(name = "platforms", version = "1.1.0")

# Rust build scripts and final linking use the same declared hermetic toolchain
# locally and on BuildBuddy. No host /nix/store compiler path enters an action.
register_toolchains("@llvm//toolchain:all")

# Expose the runtime libraries produced by the same hermetic LLVM extension.
# Rust cdylibs need the real libunwind archive rather than the toolchain's
# compatibility stub for -lgcc_s.
llvm_runtime = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_runtime, "llvm-project")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

gritql_repository = use_repo_rule("//build:grit_repository.bzl", "gritql_repository")
jextract_repository = use_repo_rule("//build:jextract_repository.bzl", "jextract_repository")

jextract_repository(name = "jextract")

gritql_repository(
    name = "gritql_source",
    attune_lib = "//src/native/grit:lib.rs",
    cargo_lock = "//src/native/grit:Cargo.lock",
    language_patches = [
        "//build:grit_patches/flix.rs",
        "//build:grit_patches/flix_binding.rs",
        "//build:grit_patches/starlark.rs",
        "//build:grit_patches/starlark_binding.rs",
        "//build:grit_patches/textual_metavariable.rs",
    ],
)

crate.from_cargo(
    name = "grit_crates",
    cargo_lockfile = "@gritql_source//:Cargo.lock",
    lockfile = "//src/native/grit:cargo-bazel-lock.json",
    manifests = ["@gritql_source//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "grit_crates")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(buildbuddy_container_image = "UBUNTU22_04_IMAGE")
use_repo(buildbuddy, "buildbuddy_toolchain")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "com.fasterxml.jackson.core:jackson-databind:2.22.1",
        "com.knuddels:jtokkit:1.1.0",
        "org.apache.arrow:arrow-dataset:19.0.0",
        "org.apache.arrow:arrow-memory-unsafe:19.0.0",
        "org.jspecify:jspecify:1.0.0",
        "org.slf4j:slf4j-nop:2.0.18",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
