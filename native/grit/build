#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"

classes="$root/.build/grit/test-classes"
jar_file="$root/.build/grit/attune-grit.jar"
root_link="$root/.build/grit/nix-root"
package=$(nix build path:.#attune-grit-jar --out-link "$root_link" --print-out-paths)

rm -rf "$classes"
mkdir -p "$classes"
install -Dm644 "$package/share/java/attune-grit.jar" "$jar_file"
javac --release 21 -cp "$jar_file" -d "$classes" native/grit/AttuneGritTest.java

# Flix caches URL JAR dependencies by name and does not notice that a local
# build product changed. Keep its managed external copy byte-for-byte current.
install -Dm644 "$jar_file" lib/external/attune-grit.jar
