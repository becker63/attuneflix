#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"

classes="$root/.build/nix/test-classes"
jar_file="$root/.build/nix/attune-nix.jar"
root_link="$root/.build/nix/nix-root"
package=$(nix build path:.#attune-nix-jar --out-link "$root_link" --print-out-paths)

rm -rf "$classes"
mkdir -p "$classes"
install -Dm644 "$package/share/java/attune-nix.jar" "$jar_file"
javac --release 23 -cp "$jar_file" -d "$classes" native/nix/AttuneNixTest.java
install -Dm644 "$jar_file" lib/external/attune-nix.jar
