#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
cd "$root"

# Bazel is the one verification graph. Nix supplies the intentionally small
# developer shell and secret-safe credential helper, not project construction.
#
# Two sequential invocations: the law suite under BuildBuddy RBE without //web/...,
# then the web suite locally. The web suite's Flix-derived Families and physical
# actions use BuildBuddy; its Node, Vite, and browser actions stay local because
# their target-config runfiles/npm bindings are not portable on this aarch64 host.
#
# The subtraction goes through a pattern file: the nix `bazel` wrapper appends its
# flags after the user's arguments, so they would land after a `--` separator.
patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
printf '%s\n' '//...' '-//web/...' > "$patterns"

rbe_config=buildbuddy-rbe
if [ "$(uname -m)" = aarch64 ]; then
  rbe_config=buildbuddy-rbe-arm64
fi

nix develop --command bazel test --target_pattern_file="$patterns" "--config=$rbe_config" "$@"

browsers_path="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
nix develop --command bazel test //web/... \
  --config=atlas-live-mixed \
  "--//web/atlas-live/e2e:browsers_path=$browsers_path" "$@"
