load("//test/build:flix.bzl", "flix_loc_law")

java_binary(
    name = "flix",
    main_class = "ca.uwaterloo.flix.Main",
    visibility = ["//visibility:public"],
    runtime_deps = ["@flix_compiler//jar"],
)

# The Flix LOC law (VAL-METRIC-002), declared per writable stage so a
# stage-local edit re-runs only that stage's law and no law target reaches
# across the stage DAG. The stage ceilings sum to 4,792, strictly below the
# repository's canonical 4,800 code-line ceiling, so the combined `src/` +
# `test/` total is strictly below 4,800 as well; every stage is additionally
# bounded on its own (strictly stronger than the single global ceiling). This
# label still names the whole law: `bazel test //:flix_loc_law_test` runs every
# stage's slice.
test_suite(
    name = "flix_loc_law_test",
    tests = [
        "//src/research:flix_loc_law_test",
        "//src/stage:flix_loc_law_test",
        "//test:flix_loc_law_test",
        "//test/Applications:flix_loc_law_test",
        "//test/Engine:flix_loc_law_test",
        "//test/Kernel:flix_loc_law_test",
        "//test/World:flix_loc_law_test",
    ],
)

# Aggregation only: every law is owned by its cell's suite (`//test/World`,
# `//test/Engine`, `//test/Applications`, `//test/Kernel`) or by the Research
# cell (`//experiments/atlas-work-topology`). This target adds no ownership of
# its own; it exists so one label names the whole law suite.
test_suite(
    name = "tests",
    tests = [
        ":flix_loc_law_test",
        "//test/Applications:applications_tests",
        "//test/Engine:engine_tests",
        "//test/Kernel:kernel_tests",
        "//test/World:world_tests",
        "//experiments/atlas-work-topology:research_tests",
    ],
)
