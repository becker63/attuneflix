# The families charter law reads the operating manual to pin the dated
# acquisition-zone carve-out beside the unchanged no-reacquisition rules.
exports_files(
    ["AGENTS.md"],
    visibility = ["//experiments/atlas-families:__pkg__"],
)

java_binary(
    name = "flix",
    main_class = "ca.uwaterloo.flix.Main",
    visibility = ["//visibility:public"],
    runtime_deps = ["@flix_compiler//jar"],
)

# The Flix LOC law (VAL-LOC-007): the combined code-line total of every tracked
# `src/` and `test/` Flix source stays strictly below 4,800 and no single file
# exceeds 400 code lines. Fails if `src/Repository.flix` grows past its
# refactor baseline. Covered by `bazel test //...` and by `./verify`.
genrule(
    name = "flix_loc_files",
    srcs = [
        "//src:flix_sources",
        "//test:flix_law_sources",
        "//test/Applications:flix_sources",
        "//test/Engine:flix_sources",
        "//test/Kernel:flix_sources",
        "//test/World:flix_sources",
    ],
    outs = ["flix_loc_files.txt"],
    cmd = "for f in $(SRCS); do echo \"$$f\"; done > $@",
)

sh_test(
    name = "flix_loc_law_test",
    size = "small",
    srcs = ["flix_loc_law.sh"],
    data = [
        ":flix_loc_files",
        "//src:flix_sources",
        "//test:flix_law_sources",
        "//test/Applications:flix_sources",
        "//test/Engine:flix_sources",
        "//test/Kernel:flix_sources",
        "//test/World:flix_sources",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# Aggregation only: every law is owned by its cell's suite (`//test/World`,
# `//test/Engine`, `//test/Applications`, `//test/Kernel`) or by the Research
# cell (`//experiments/atlas-work-topology`, `//experiments/atlas-families`).
# This target adds no ownership of its own; it exists so one label names the
# whole law suite.
test_suite(
    name = "tests",
    tests = [
        "//experiments/atlas-anchors:anchor_test",
        "//experiments/atlas-families:families_tests",
        "//experiments/atlas-work-topology:research_tests",
        "//test/Applications:applications_tests",
        "//test/Engine:engine_tests",
        "//test/Kernel:kernel_tests",
        "//test/World:world_tests",
        "//web/atlas-live:tests",
    ],
)
