java_binary(
    name = "flix",
    main_class = "ca.uwaterloo.flix.Main",
    visibility = ["//visibility:public"],
    runtime_deps = ["@flix_compiler//jar"],
)

# Aggregation only: every law is owned by its cell's suite (`//test/World`,
# `//test/Engine`, `//test/Applications`, `//test/Kernel`) or by the Research
# cell (`//experiments/atlas-work-topology`). This target adds no ownership of
# its own; it exists so one label names the whole law suite.
test_suite(
    name = "tests",
    tests = [
        "//test/Applications:applications_tests",
        "//test/Engine:engine_tests",
        "//test/Kernel:kernel_tests",
        "//test/World:world_tests",
        "//experiments/atlas-work-topology:research_tests",
    ],
)
